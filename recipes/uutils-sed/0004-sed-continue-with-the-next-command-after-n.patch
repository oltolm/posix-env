From 5003c7be1a491849533abf7de1746023d83744fb Mon Sep 17 00:00:00 2001
From: Oleg Tolmatcev <oleg.tolmatcev@gmail.com>
Date: Thu, 1 Oct 2026 22:16:42 +0200
Subject: [PATCH 4/5] sed: continue with the next command after `n`

`n` ended the cycle, so the next line started the script from the top
instead of going on with the command after `n`. Autoconf's config.status
reads multi-line substitution values with `n` and `b`, so variables with
such values were written as broken awk code (`S["tdir_i386pep=..."` in
binutils' ld), and config.status failed.

Print the pattern space unless -n, flush appended text, and resume with
the following command once the next line is read, as `N` already does.
At the end of input nothing more is printed, as with GNU sed.
---
 src/sed/command.rs        |  5 +++--
 src/sed/processor.rs      | 31 +++++++++++++++++++++----------
 tests/by-util/test_sed.rs | 33 +++++++++++++++++++++++++++++++++
 3 files changed, 57 insertions(+), 12 deletions(-)

diff --git a/src/sed/command.rs b/src/sed/command.rs
index dbf3786..b0986a2 100644
--- a/src/sed/command.rs
+++ b/src/sed/command.rs
@@ -386,8 +386,9 @@ pub enum SpaceFlag {
 pub struct InputAction {
     /// Next command to execute (rather than commands from start)
     pub next_command: Option<Rc<RefCell<Command>>>,
-    /// Data to prepend to the read contents
-    pub prepend: Vec<u8>,
+    /// Pattern space the next line is appended to (`N`), or `None` when the
+    /// next line replaces the pattern space (`n`)
+    pub prepend: Option<Vec<u8>>,
 }
 
 #[cfg(test)]
diff --git a/src/sed/processor.rs b/src/sed/processor.rs
index 67441ca..df654dc 100644
--- a/src/sed/processor.rs
+++ b/src/sed/processor.rs
@@ -650,12 +650,12 @@ fn process_file(
         // Set the script command from which to start.
         let mut current: Option<Rc<RefCell<Command>>> =
             if let Some(action) = context.input_action.take() {
-                // Continue processing the `N` command.
-                let mut combined_lines = action.prepend;
-                combined_lines.push(b'\n');
-                combined_lines.extend_from_slice(pattern.as_bytes());
-
-                pattern.set_to_bytes(combined_lines, pattern.is_newline_terminated());
+                // Continue after an `N` or `n` command.
+                if let Some(mut combined_lines) = action.prepend {
+                    combined_lines.push(b'\n');
+                    combined_lines.extend_from_slice(pattern.as_bytes());
+                    pattern.set_to_bytes(combined_lines, pattern.is_newline_terminated());
+                }
                 action.next_command
             } else {
                 // Start from the script top.
@@ -769,7 +769,18 @@ fn process_file(
                     list(output, &pattern, width, &command.location, context)?;
                 }
                 'n' => {
-                    break;
+                    // Print the pattern space and continue with the next
+                    // command once the next line has been read; ending the
+                    // cycle here would restart the script from the top.
+                    if !context.quiet {
+                        write_chunk(output, context, &pattern)?;
+                    }
+                    flush_appends(output, context)?;
+                    context.input_action = Some(InputAction {
+                        next_command: command.next.clone(),
+                        prepend: None,
+                    });
+                    continue 'lines;
                 }
                 'N' => {
                     flush_appends(output, context)?;
@@ -779,7 +790,7 @@ fn process_file(
                     // to perform when the next line is read.
                     context.input_action = Some(InputAction {
                         next_command: command.next.clone(),
-                        prepend: pattern.as_bytes().to_vec(),
+                        prepend: Some(pattern.as_bytes().to_vec()),
                     });
                     continue 'lines;
                 }
@@ -907,8 +918,8 @@ fn process_file(
     if context.separate
         && !context.quiet
         && let Some(action) = context.input_action.take()
+        && let Some(mut pending) = action.prepend
     {
-        let mut pending = action.prepend;
         pending.push(b'\n');
         output.write_bytes(&pending)?;
         if context.unbuffered {
@@ -968,8 +979,8 @@ pub fn process_all_files(
             && !context.separate
             && !context.quiet
             && let Some(action) = context.input_action.take()
+            && let Some(mut pending) = action.prepend
         {
-            let mut pending = action.prepend;
             pending.push(b'\n');
             output.write_bytes(&pending)?;
         }
diff --git a/tests/by-util/test_sed.rs b/tests/by-util/test_sed.rs
index 026c059..e6f2a17 100644
--- a/tests/by-util/test_sed.rs
+++ b/tests/by-util/test_sed.rs
@@ -543,6 +543,39 @@ check_output!(subst_re_reuse, ["-e", r"2s//M/;1s/l/L/", LINES1]);
 check_output!(subst_newline_class, ["-n", r"1{;N;s/[\n]/X/;p;}", LINES1]);
 check_output!(subst_newline_re, ["-n", r"1{;N;s/\n/X/;p;}", LINES1]);
 
+// `n` replaces the pattern space with the next line and goes on with the
+// following command instead of restarting the script; autoconf's
+// config.status relies on this for multi-line substitution values.
+#[test]
+fn next_line_continues_with_following_command() {
+    new_ucmd!()
+        .args(&["-n", "s/^/top:/p\nn\nb y\ns/^/skipped:/p\n:y\ns/^/y:/p"])
+        .pipe_in("a\nb\nc\n")
+        .succeeds()
+        .stdout_is("top:a\ny:b\ntop:c\n");
+}
+
+#[test]
+fn next_line_resets_substitution_flag() {
+    new_ucmd!()
+        .args(&[
+            "-n",
+            "s/^/top:/p\nn\nt z\ns/^/no-t:/p\nb\n:z\ns/^/t-taken:/p",
+        ])
+        .pipe_in("a\nb\nc\n")
+        .succeeds()
+        .stdout_is("top:a\nno-t:b\ntop:c\n");
+}
+
+#[test]
+fn next_line_prints_pattern_and_appended_text() {
+    new_ucmd!()
+        .arg("a\\\nAPP\nn\ns/^/Y/")
+        .pipe_in("a\nb\nc\n")
+        .succeeds()
+        .stdout_is("a\nAPP\nYb\nc\nAPP\n");
+}
+
 #[test]
 fn subst_dot_matches_newline() {
     new_ucmd!()
-- 
