+
+/// The `--version` probe on Windows, where MinGW toolchains ship `cc.exe`
+/// and `c++.exe` (GCC in MinGW-w64, Clang in llvm-mingw) and make's
+/// default `CC=cc` runs them.  Without a process group to kill, the child
+/// alone is killed on timeout, and its output is not waited for then: a
+/// grandchild holding the pipes open cannot stall recognition.
+#[cfg(windows)]
+mod windows {
+    use super::super::identity::CompilerType;
+    use super::CompilerProbe;
+    use super::classify_version_output;
+    use std::io::Read;
+    use std::path::Path;
+    use std::process::{Command, Stdio};
+    use std::thread;
+    use std::time::{Duration, Instant};
+
+    /// Runs `<exe> --version`, classifies the output. Default timeout: 2 seconds.
+    pub(crate) struct VersionProbe {
+        timeout: Duration,
+    }
+
+    impl VersionProbe {
+        pub(crate) fn new() -> Self {
+            Self { timeout: Duration::from_secs(2) }
+        }
+    }
+
+    impl CompilerProbe for VersionProbe {
+        fn probe(&self, executable_path: &Path) -> Option<CompilerType> {
+            let mut child = match Command::new(executable_path)
+                .arg("--version")
+                .stdin(Stdio::null())
+                .stdout(Stdio::piped())
+                .stderr(Stdio::piped())
+                .spawn()
+            {
+                Ok(c) => c,
+                Err(err) => {
+                    log::debug!("probe: spawn failed for {}: {err}", executable_path.display());
+                    return None;
+                }
+            };
+            let read = |pipe: Option<Box<dyn Read + Send>>| {
+                thread::spawn(move || {
+                    let mut buffer = Vec::new();
+                    if let Some(mut pipe) = pipe {
+                        let _ = pipe.read_to_end(&mut buffer);
+                    }
+                    buffer
+                })
+            };
+            let stdout = read(child.stdout.take().map(|p| Box::new(p) as Box<dyn Read + Send>));
+            let stderr = read(child.stderr.take().map(|p| Box::new(p) as Box<dyn Read + Send>));
+
+            let deadline = Instant::now() + self.timeout;
+            let status = loop {
+                match child.try_wait() {
+                    Ok(Some(status)) => break status,
+                    Ok(None) if Instant::now() < deadline => thread::sleep(Duration::from_millis(5)),
+                    Ok(None) => {
+                        log::debug!("probe: {} timed out", executable_path.display());
+                        let _ = child.kill();
+                        let _ = child.wait();
+                        return None;
+                    }
+                    Err(err) => {
+                        log::debug!("probe: wait failed for {}: {err}", executable_path.display());
+                        return None;
+                    }
+                }
+            };
+            if !status.success() {
+                log::debug!("probe: {} exited with {:?}", executable_path.display(), status);
+                return None;
+            }
+            let stdout = stdout.join().unwrap_or_default();
+            let stderr = stderr.join().unwrap_or_default();
+            classify_version_output(&String::from_utf8_lossy(&stdout), &String::from_utf8_lossy(&stderr))
+        }
+    }
+}
