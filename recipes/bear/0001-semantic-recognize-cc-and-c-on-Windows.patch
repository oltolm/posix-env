+++ b/crates/semantic/src/interpreters/compilers/compiler_recognition.rs
@@ -104,6 +104,12 @@ impl CompilerRecognizer {
         //    itself (`CachingProbe`) so the cost is at most
         //    one fork+exec per unique compiler path per process.
         let filename = executable_path.file_name().and_then(|n| n.to_str()).unwrap_or("");
+        // Windows programs carry their extension: cc.exe is cc.
+        #[cfg(windows)]
+        let filename = match filename.len().checked_sub(4) {
+            Some(n) if filename.is_char_boundary(n) && filename[n..].eq_ignore_ascii_case(".exe") => &filename[..n],
+            _ => filename,
+        };
         if AMBIGUOUS_NAMES.contains(&filename)
             && let Some(t) = self.probe_canonical(executable_path)
         {
