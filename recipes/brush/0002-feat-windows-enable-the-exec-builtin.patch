From 1a7499f9e4f5a1ff33a56f1d47ff0fddfc4bc988 Mon Sep 17 00:00:00 2001
From: Oleg Tolmatcev <oleg.tolmatcev@gmail.com>
Date: Thu, 26 Nov 2026 14:35:08 +0100
Subject: [PATCH] feat(windows): enable the exec builtin

`exec` was registered only on Unix, so `exec 5>>config.log`, which
every autoconf configure script starts with, failed with "command not
found".

The redirection-only form is portable. With a command, Windows cannot
replace the running process image, so run the command and leave the
shell with its exit status.

Assisted-by: Claude Code:claude-opus-5-5

Rebased for brush 0.5.0.
Assisted-by: Codex:GPT-6
---
 brush-builtins/src/exec.rs              | 16 +++++++++++-----
 brush-shell/tests/cases/brush/exec.yaml | 13 +++++++++++++
 2 files changed, 24 insertions(+), 5 deletions(-)
 create mode 100644 brush-shell/tests/cases/brush/exec.yaml

diff --git a/brush-builtins/src/exec.rs b/brush-builtins/src/exec.rs
index f09d2c0e..d9844c3a 100644
--- a/brush-builtins/src/exec.rs
+++ b/brush-builtins/src/exec.rs
@@ -48,11 +48,13 @@ impl<SE: brush_core::ShellExtensions> builtins::Builtin<SE> for ExecCommand {
 
         // If we know we're already running in a subshell, then `exec`ing is actually
         // unsafe, since it would also replace the *parent* shell instance. We instead
-        // delegate to the `command` builtin to perform the execution, with an expectation
-        // of returning.
-        if context.shell.is_subshell() {
+        // delegate to the `command` builtin to perform the execution. Windows also
+        // uses this path because it cannot replace the running process image.
+        if context.shell.is_subshell() || cfg!(windows) {
             if self.empty_environment || self.exec_as_login || self.name_for_argv0.is_some() {
-                return brush_core::error::unimp("exec with options in subshell not yet supported");
+                return brush_core::error::unimp(
+                    "exec with options in subshell or on Windows not yet supported",
+                );
             }
 
             let cmd_cmd = crate::command::CommandCommand {
@@ -60,7 +62,11 @@ impl<SE: brush_core::ShellExtensions> builtins::Builtin<SE> for ExecCommand {
                 ..Default::default()
             };
 
-            return cmd_cmd.execute(context).await;
+            let mut result = cmd_cmd.execute(context).await?;
+            if cfg!(windows) {
+                result.next_control_flow = brush_core::ExecutionControlFlow::ExitShell;
+            }
+            return Ok(result);
         }
 
         let mut argv0 = Cow::Borrowed(self.name_for_argv0.as_ref().unwrap_or(&self.args[0]));
diff --git a/brush-shell/tests/cases/brush/exec.yaml b/brush-shell/tests/cases/brush/exec.yaml
new file mode 100644
index 00000000..ede3f63c
--- /dev/null
+++ b/brush-shell/tests/cases/brush/exec.yaml
@@ -0,0 +1,13 @@
+name: "exec"
+cases:
+  # configure scripts start with `exec 5>>config.log` and write to fd 5
+  # throughout; uses builtins only so that it also runs on Windows.
+  - name: "exec with only redirections opens and closes shell fds"
+    stdin: |
+      exec 5>out.txt
+      echo hello >&5
+      exec 5>&-
+      read -r line < out.txt
+      echo "read: $line"
+    expected_exit_code: 0
+    expected_stdout: "read: hello\n"
