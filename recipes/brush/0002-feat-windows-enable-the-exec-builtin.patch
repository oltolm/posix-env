From 895296b2f9e2c9cc1a20173de0bb5ff7dcf324f4 Mon Sep 17 00:00:00 2001
From: Oleg Tolmatcev <oleg.tolmatcev@gmail.com>
Date: Thu, 1 Oct 2026 17:00:52 +0200
Subject: [PATCH 02/21] feat(windows): enable the exec builtin

`exec` was registered only on Unix, so `exec 5>>config.log`, which
every autoconf configure script starts with, failed with "command not
found".

The redirection-only form is portable. With a command, Windows cannot
replace the running process image, so run the command and leave the
shell with its exit status.

Assisted-by: Claude Code:claude-opus-5-5
---
 brush-builtins/src/exec.rs              | 56 ++++++++++++++++++-------
 brush-builtins/src/factory.rs           |  2 +-
 brush-builtins/src/lib.rs               |  2 +-
 brush-shell/tests/cases/brush/exec.yaml | 13 ++++++
 4 files changed, 55 insertions(+), 18 deletions(-)
 create mode 100644 brush-shell/tests/cases/brush/exec.yaml

diff --git a/brush-builtins/src/exec.rs b/brush-builtins/src/exec.rs
index d3ade049..a4ff4d6c 100644
--- a/brush-builtins/src/exec.rs
+++ b/brush-builtins/src/exec.rs
@@ -1,7 +1,10 @@
 use clap::Parser;
+#[cfg(unix)]
 use std::{borrow::Cow, os::unix::process::CommandExt};
 
-use brush_core::{ErrorKind, ExecutionExitCode, ExecutionResult, builtins, commands};
+#[cfg(unix)]
+use brush_core::{ErrorKind, ExecutionExitCode, commands};
+use brush_core::{ExecutionResult, builtins};
 
 /// Exec the provided command.
 #[derive(Parser)]
@@ -58,26 +61,47 @@ impl builtins::Command for ExecCommand {
             return cmd_cmd.execute(context).await;
         }
 
-        let mut argv0 = Cow::Borrowed(self.name_for_argv0.as_ref().unwrap_or(&self.args[0]));
+        #[cfg(unix)]
+        {
+            let mut argv0 = Cow::Borrowed(self.name_for_argv0.as_ref().unwrap_or(&self.args[0]));
 
-        if self.exec_as_login {
-            argv0 = Cow::Owned(std::format!("-{argv0}"));
+            if self.exec_as_login {
+                argv0 = Cow::Owned(std::format!("-{argv0}"));
+            }
+
+            let mut cmd = commands::compose_std_command(
+                &context,
+                &self.args[0],
+                argv0.as_str(),
+                &self.args[1..],
+                self.empty_environment,
+            )?;
+
+            let exec_error = cmd.exec();
+
+            if exec_error.kind() == std::io::ErrorKind::NotFound {
+                Ok(ExecutionExitCode::NotFound.into())
+            } else {
+                Err(ErrorKind::from(exec_error).into())
+            }
         }
 
-        let mut cmd = commands::compose_std_command(
-            &context,
-            &self.args[0],
-            argv0.as_str(),
-            &self.args[1..],
-            self.empty_environment,
-        )?;
+        // Windows cannot replace the running process image; run the command
+        // to completion and leave the shell with its status instead.
+        #[cfg(windows)]
+        {
+            if self.empty_environment || self.exec_as_login || self.name_for_argv0.is_some() {
+                return brush_core::error::unimp("exec with options not supported on Windows");
+            }
 
-        let exec_error = cmd.exec();
+            let cmd_cmd = crate::command::CommandCommand {
+                command_and_args: self.args.clone(),
+                ..Default::default()
+            };
 
-        if exec_error.kind() == std::io::ErrorKind::NotFound {
-            Ok(ExecutionExitCode::NotFound.into())
-        } else {
-            Err(ErrorKind::from(exec_error).into())
+            let mut result = cmd_cmd.execute(context).await?;
+            result.next_control_flow = brush_core::ExecutionControlFlow::ExitShell;
+            Ok(result)
         }
     }
 }
diff --git a/brush-builtins/src/factory.rs b/brush-builtins/src/factory.rs
index 99eeb8e4..e775b34d 100644
--- a/brush-builtins/src/factory.rs
+++ b/brush-builtins/src/factory.rs
@@ -52,7 +52,7 @@ pub fn default_builtins<SE: brush_core::ShellExtensions>(
     m.insert(".".into(), builtin::<dot::DotCommand, SE>().special());
     #[cfg(feature = "builtin.eval")]
     m.insert("eval".into(), builtin::<eval::EvalCommand, SE>().special());
-    #[cfg(all(feature = "builtin.exec", unix))]
+    #[cfg(all(feature = "builtin.exec", any(unix, windows)))]
     m.insert("exec".into(), builtin::<exec::ExecCommand, SE>().special());
     #[cfg(feature = "builtin.exit")]
     m.insert("exit".into(), builtin::<exit::ExitCommand, SE>().special());
diff --git a/brush-builtins/src/lib.rs b/brush-builtins/src/lib.rs
index 0dd7fab3..c67620b3 100644
--- a/brush-builtins/src/lib.rs
+++ b/brush-builtins/src/lib.rs
@@ -47,7 +47,7 @@ mod echo;
 mod enable;
 #[cfg(feature = "builtin.eval")]
 mod eval;
-#[cfg(all(feature = "builtin.exec", unix))]
+#[cfg(all(feature = "builtin.exec", any(unix, windows)))]
 mod exec;
 #[cfg(feature = "builtin.exit")]
 mod exit;
diff --git a/brush-shell/tests/cases/brush/exec.yaml b/brush-shell/tests/cases/brush/exec.yaml
new file mode 100644
index 00000000..ede3f63c
--- /dev/null
+++ b/brush-shell/tests/cases/brush/exec.yaml
@@ -0,0 +1,13 @@
+name: "exec"
+cases:
+  # configure scripts start with `exec 5>>config.log` and write to fd 5
+  # throughout; uses builtins only so that it also runs on Windows.
+  - name: "exec with only redirections opens and closes shell fds"
+    stdin: |
+      exec 5>out.txt
+      echo hello >&5
+      exec 5>&-
+      read -r line < out.txt
+      echo "read: $line"
+    expected_exit_code: 0
+    expected_stdout: "read: hello\n"
