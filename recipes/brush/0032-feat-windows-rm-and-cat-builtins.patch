diff --git a/brush-builtins/src/cat.rs b/brush-builtins/src/cat.rs
new file mode 100644
--- /dev/null
+++ b/brush-builtins/src/cat.rs
@@ -0,0 +1,80 @@
+use clap::Parser;
+use std::io::Write;
+
+use brush_core::{ExecutionResult, builtins};
+
+/// Concatenate files to standard output.
+///
+/// Copies the operands itself when no options are given; with options, and
+/// for each operand that cannot be opened, the external cat runs instead.
+#[derive(Parser)]
+#[clap(disable_help_flag = true, disable_version_flag = true)]
+pub(crate) struct CatCommand {
+    /// Operands, as given.
+    #[arg(trailing_var_arg = true, allow_hyphen_values = true)]
+    args: Vec<String>,
+}
+
+impl builtins::Command for CatCommand {
+    type Error = brush_core::Error;
+
+    fn new<I>(args: I) -> Result<Self, clap::Error>
+    where
+        I: IntoIterator<Item = String>,
+    {
+        Ok(Self {
+            args: args.into_iter().skip(1).collect(),
+        })
+    }
+
+    async fn execute<SE: brush_core::ShellExtensions>(
+        &self,
+        mut context: brush_core::ExecutionContext<'_, SE>,
+    ) -> Result<ExecutionResult, Self::Error> {
+        let operands = match self.args.iter().position(|a| a == "--") {
+            Some(i) if !has_options(&self.args[..i]) => &self.args[i + 1..],
+            None if !has_options(&self.args) => &self.args[..],
+            _ => return crate::external::run(&mut context, "cat", self.args.iter().cloned()).await,
+        };
+
+        let stdin_operand = ["-".to_owned()];
+        let operands = if operands.is_empty() {
+            &stdin_operand[..]
+        } else {
+            operands
+        };
+
+        let mut out = context.stdout();
+        let mut result = Ok(ExecutionResult::success());
+        for operand in operands {
+            let copied = if operand == "-" {
+                std::io::copy(&mut context.stdin(), &mut out)
+            } else if let Ok(mut file) = std::fs::File::open(context.shell.absolute_path(operand)) {
+                std::io::copy(&mut file, &mut out)
+            } else {
+                // Later operands are still copied, as cat does.
+                let status =
+                    crate::external::run(&mut context, "cat", ["--".to_owned(), operand.clone()])
+                        .await;
+                if !status.as_ref().is_ok_and(ExecutionResult::is_success) {
+                    result = status;
+                }
+                continue;
+            };
+            if let Err(e) = copied.and_then(|_| out.flush()) {
+                // A closed pipe ends cat quietly, as SIGPIPE does on Unix.
+                if e.kind() != std::io::ErrorKind::BrokenPipe {
+                    writeln!(context.stderr(), "cat: {operand}: {e}")?;
+                }
+                return Ok(ExecutionResult::general_error());
+            }
+        }
+        result
+    }
+}
+
+/// Returns true if any argument is an option (anything starting with '-'
+/// except "-" itself, which names standard input).
+fn has_options(args: &[String]) -> bool {
+    args.iter().any(|a| a.starts_with('-') && a.len() > 1)
+}
diff --git a/brush-builtins/src/external.rs b/brush-builtins/src/external.rs
new file mode 100644
--- /dev/null
+++ b/brush-builtins/src/external.rs
@@ -0,0 +1,33 @@
+//! Hands a command to the external program of the same name, bypassing the
+//! builtin.  Used by the file utility builtins for every case they do not
+//! handle themselves, so the external program's options, messages and exit
+//! status apply unchanged.
+
+use brush_core::{ExecutionResult, commands};
+
+/// Runs the program `name` found in PATH with `args` (without `argv[0]`),
+/// using the builtin's redirections.
+pub(crate) async fn run<SE: brush_core::ShellExtensions>(
+    context: &mut brush_core::ExecutionContext<'_, SE>,
+    name: &str,
+    args: impl IntoIterator<Item = String>,
+) -> Result<ExecutionResult, brush_core::Error> {
+    let Some(path) = context.shell.resolve_command_in_path_using_cache(name) else {
+        return Err(brush_core::ErrorKind::CommandNotFound(name.to_owned()).into());
+    };
+
+    // A command name with a path separator is never looked up as a builtin.
+    let path = path.to_string_lossy().into_owned();
+    let mut cmd = commands::SimpleCommand::new(
+        commands::ShellForCommand::ParentShell(context.shell),
+        context.params.clone(),
+        path.clone(),
+        std::iter::once(path)
+            .chain(args)
+            .map(brush_core::CommandArg::String),
+    );
+    cmd.argv0 = Some(name.to_owned());
+    cmd.use_functions = false;
+
+    Ok(cmd.execute().await?.wait().await?.into())
+}
