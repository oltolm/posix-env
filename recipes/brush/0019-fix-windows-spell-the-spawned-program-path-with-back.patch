From ea829fac796d85a7e3489a6058f368add74eb152 Mon Sep 17 00:00:00 2001
From: Oleg Tolmatcev <oleg.tolmatcev@gmail.com>
Date: Thu, 26 Nov 2026 14:35:10 +0100
Subject: [PATCH] fix(windows): spell the spawned program path with backslashes

PATH entries are joined with `/`, so `cmd` resolves to
`C:\WINDOWS\System32/cmd.exe`.  That path starts the child's command
line, and cmd.exe scans its whole command line for switches: it read
the `/cmd.exe` as `/c md.exe`, so `cmd /c echo hi` failed with "The
system cannot find the path specified".  libtool's "whether to use cmd
with one slash or two slashes" check then stopped configure with "Do
not know how to convert paths".

Convert `/` to `\` in the program path handed to CreateProcess.  The
path the shell reports (`command -v`, `$_`) keeps its `/`.

Assisted-by: Claude Code:claude-opus-5-5

Rebased for brush 0.5.0.
Assisted-by: Codex:GPT-6
---
 brush-core/src/sys/tokio_process.rs | 28 +++++++++++++++++++++++++++-
 1 file changed, 27 insertions(+), 1 deletion(-)

diff --git a/brush-core/src/sys/tokio_process.rs b/brush-core/src/sys/tokio_process.rs
index 01489a33..64da85e7 100644
--- a/brush-core/src/sys/tokio_process.rs
+++ b/brush-core/src/sys/tokio_process.rs
@@ -60,7 +60,11 @@ pub(crate) fn exec(command: LaunchRequest) -> std::io::Error {
 
 /// Composes the `std::process::Command` that starts a process.
 fn compose_std_command(command: LaunchRequest) -> std::io::Result<std::process::Command> {
-    let mut cmd = std::process::Command::new(command.program);
+    #[cfg(windows)]
+    let program = windows_program_path(&command.program);
+    #[cfg(not(windows))]
+    let program = command.program;
+    let mut cmd = std::process::Command::new(program);
 
     // Override argv[0].
     // NOTE: Not supported on all platforms.
@@ -181,3 +185,25 @@ mod quoting_tests {
         assert_eq!(quote_windows_arg(r#"a\"*"#), r#""a\\\"*""#);
     }
 }
+
+/// Spells a program path with `\` separators for `CreateProcess`.
+///
+/// The shell joins PATH entries with `/` (see `join_command_path`), but the program
+/// path becomes the start of the child's command line, and some programs parse it:
+/// cmd.exe reads the `/cmd.exe` in `C:\WINDOWS\System32/cmd.exe` as a switch.
+#[cfg(windows)]
+fn windows_program_path(path: &std::path::Path) -> std::ffi::OsString {
+    use std::os::windows::ffi::{OsStrExt, OsStringExt};
+    let wide: Vec<u16> = path
+        .as_os_str()
+        .encode_wide()
+        .map(|c| {
+            if c == u16::from(b'/') {
+                u16::from(b'\\')
+            } else {
+                c
+            }
+        })
+        .collect();
+    std::ffi::OsString::from_wide(&wide)
+}
