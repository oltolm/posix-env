From fcedbdca46377b1ca69e1d5d360164e3e795ee2f Mon Sep 17 00:00:00 2001
From: Oleg Tolmatcev <oleg.tolmatcev@gmail.com>
Date: Thu, 1 Oct 2026 17:00:53 +0200
Subject: [PATCH 06/21] feat(windows): accept POSIX signal names and numbers in
 trap

The stub Signal type had no variants, so `trap ... 1 2 13 15`, as in
every configure script, failed; trap is a special builtin, so the error
ended the script.

Give the stub platforms the conventional POSIX signal table. Handlers
for signals the platform never delivers simply never run, as on
Cygwin.

Assisted-by: Claude Code:claude-opus-5-5
---
 brush-core/src/sys/stubs/signal.rs | 140 +++++++++++++++++++++++++++--
 1 file changed, 134 insertions(+), 6 deletions(-)

diff --git a/brush-core/src/sys/stubs/signal.rs b/brush-core/src/sys/stubs/signal.rs
index 772a15b4..b0df5f7a 100644
--- a/brush-core/src/sys/stubs/signal.rs
+++ b/brush-core/src/sys/stubs/signal.rs
@@ -2,25 +2,128 @@
 
 use crate::{error, sys, traps};
 
-/// A stub enum representing system signals on unsupported platforms.
+/// POSIX signals, by their conventional numbers.
+///
+/// Platforms without POSIX signals never deliver most of these, but scripts
+/// still install handlers for them (autoconf's `configure` traps 1, 2, 13
+/// and 15), so the names and numbers must be accepted, as Cygwin does.
 #[allow(unnameable_types)]
+#[allow(
+    clippy::upper_case_acronyms,
+    reason = "names match nix::sys::signal::Signal, used on Unix"
+)]
 #[derive(Clone, Copy, Debug, Eq, Hash, PartialEq)]
-pub enum Signal {}
+#[repr(i32)]
+pub enum Signal {
+    SIGHUP = 1,
+    SIGINT = 2,
+    SIGQUIT = 3,
+    SIGILL = 4,
+    SIGTRAP = 5,
+    SIGABRT = 6,
+    SIGBUS = 7,
+    SIGFPE = 8,
+    SIGKILL = 9,
+    SIGUSR1 = 10,
+    SIGSEGV = 11,
+    SIGUSR2 = 12,
+    SIGPIPE = 13,
+    SIGALRM = 14,
+    SIGTERM = 15,
+    SIGCHLD = 17,
+    SIGCONT = 18,
+    SIGSTOP = 19,
+    SIGTSTP = 20,
+    SIGTTIN = 21,
+    SIGTTOU = 22,
+    SIGURG = 23,
+    SIGXCPU = 24,
+    SIGXFSZ = 25,
+    SIGVTALRM = 26,
+    SIGPROF = 27,
+    SIGWINCH = 28,
+    SIGIO = 29,
+    SIGSYS = 31,
+}
+
+const ALL_SIGNALS: [Signal; 29] = [
+    Signal::SIGHUP,
+    Signal::SIGINT,
+    Signal::SIGQUIT,
+    Signal::SIGILL,
+    Signal::SIGTRAP,
+    Signal::SIGABRT,
+    Signal::SIGBUS,
+    Signal::SIGFPE,
+    Signal::SIGKILL,
+    Signal::SIGUSR1,
+    Signal::SIGSEGV,
+    Signal::SIGUSR2,
+    Signal::SIGPIPE,
+    Signal::SIGALRM,
+    Signal::SIGTERM,
+    Signal::SIGCHLD,
+    Signal::SIGCONT,
+    Signal::SIGSTOP,
+    Signal::SIGTSTP,
+    Signal::SIGTTIN,
+    Signal::SIGTTOU,
+    Signal::SIGURG,
+    Signal::SIGXCPU,
+    Signal::SIGXFSZ,
+    Signal::SIGVTALRM,
+    Signal::SIGPROF,
+    Signal::SIGWINCH,
+    Signal::SIGIO,
+    Signal::SIGSYS,
+];
 
 impl Signal {
     /// Returns an iterator over all possible signals.
     pub fn iterator() -> impl Iterator<Item = Self> {
-        std::iter::empty()
+        ALL_SIGNALS.into_iter()
     }
 
     /// Converts the signal into its corresponding name as a `&'static str`.
     pub const fn as_str(self) -> &'static str {
-        ""
+        match self {
+            Self::SIGHUP => "SIGHUP",
+            Self::SIGINT => "SIGINT",
+            Self::SIGQUIT => "SIGQUIT",
+            Self::SIGILL => "SIGILL",
+            Self::SIGTRAP => "SIGTRAP",
+            Self::SIGABRT => "SIGABRT",
+            Self::SIGBUS => "SIGBUS",
+            Self::SIGFPE => "SIGFPE",
+            Self::SIGKILL => "SIGKILL",
+            Self::SIGUSR1 => "SIGUSR1",
+            Self::SIGSEGV => "SIGSEGV",
+            Self::SIGUSR2 => "SIGUSR2",
+            Self::SIGPIPE => "SIGPIPE",
+            Self::SIGALRM => "SIGALRM",
+            Self::SIGTERM => "SIGTERM",
+            Self::SIGCHLD => "SIGCHLD",
+            Self::SIGCONT => "SIGCONT",
+            Self::SIGSTOP => "SIGSTOP",
+            Self::SIGTSTP => "SIGTSTP",
+            Self::SIGTTIN => "SIGTTIN",
+            Self::SIGTTOU => "SIGTTOU",
+            Self::SIGURG => "SIGURG",
+            Self::SIGXCPU => "SIGXCPU",
+            Self::SIGXFSZ => "SIGXFSZ",
+            Self::SIGVTALRM => "SIGVTALRM",
+            Self::SIGPROF => "SIGPROF",
+            Self::SIGWINCH => "SIGWINCH",
+            Self::SIGIO => "SIGIO",
+            Self::SIGSYS => "SIGSYS",
+        }
     }
 
     /// Creates a `Signal` from a string representation.
     pub fn from_str(s: &str) -> Result<Self, error::Error> {
-        Err(error::ErrorKind::InvalidSignal(s.into()).into())
+        Self::iterator()
+            .find(|sig| sig.as_str() == s)
+            .ok_or_else(|| error::ErrorKind::InvalidSignal(s.into()).into())
     }
 }
 
@@ -28,7 +131,9 @@ impl TryFrom<i32> for Signal {
     type Error = error::Error;
 
     fn try_from(value: i32) -> Result<Self, Self::Error> {
-        Err(error::ErrorKind::InvalidSignal(std::format!("{value}")).into())
+        Self::iterator()
+            .find(|sig| *sig as i32 == value)
+            .ok_or_else(|| error::ErrorKind::InvalidSignal(std::format!("{value}")).into())
     }
 }
 
@@ -89,3 +194,26 @@ pub(crate) fn mask_sigttou() -> Result<(), error::Error> {
 pub(crate) fn poll_for_stopped_children() -> Result<bool, error::Error> {
     Ok(false)
 }
+
+#[cfg(test)]
+mod tests {
+    use super::Signal;
+
+    /// configure installs `trap ... 1 2 13 15`; `trap` must accept these.
+    #[test]
+    fn posix_numbers_and_names_are_accepted() {
+        assert_eq!(Signal::try_from(1).unwrap(), Signal::SIGHUP);
+        assert_eq!(Signal::try_from(15).unwrap(), Signal::SIGTERM);
+        assert_eq!(Signal::from_str("SIGPIPE").unwrap() as i32, 13);
+        assert!(Signal::try_from(16).is_err());
+        assert!(Signal::from_str("SIGNONE").is_err());
+    }
+
+    #[test]
+    fn names_and_numbers_round_trip() {
+        for signal in Signal::iterator() {
+            assert_eq!(Signal::from_str(signal.as_str()).unwrap(), signal);
+            assert_eq!(Signal::try_from(signal as i32).unwrap(), signal);
+        }
+    }
+}
