+        // Like bash, warn and carry on outside a loop.
+        let loop_depth = context.shell.loop_depth();
+        if loop_depth == 0 {
+            let _ = writeln!(
+                context.stderr(),
+                "{}: only meaningful in a `for', `while', or `until' loop",
+                context.command_name
+            );
+            return Ok(ExecutionResult::success());
+        }
+
         let mut result = ExecutionResult::success();
 
+        // Breaking out of more loops than there are leaves all of them.
         result.next_control_flow = ExecutionControlFlow::BreakLoop {
             #[expect(clippy::cast_sign_loss)]
-            levels: (self.which_loop - 1) as usize,
+            levels: (self.which_loop as usize).min(loop_depth) - 1,
         };
 
         Ok(result)
