 impl<SE: extensions::ShellExtensions> Shell<SE> {
+    /// Returns the number of loops enclosing the current command, counting only those in
+    /// the current function or subshell, as `break` and `continue` do.
+    pub const fn loop_depth(&self) -> usize {
+        self.loop_depth
+    }
+
+    /// Sets the loop depth, returning the previous one.
+    pub(crate) const fn replace_loop_depth(&mut self, loop_depth: usize) -> usize {
+        std::mem::replace(&mut self.loop_depth, loop_depth)
+    }
+
     /// Increments the interactive line offset in the shell by the indicated number
     /// of lines. The interactive loop calls this once after each command it runs, so
     /// it also advances the command number that the `\#` prompt escape shows.
