new file mode 100644
index 00000000..042d9bbd
--- /dev/null
+++ b/brush-shell/tests/cases/compat/builtins/break.yaml
@@ -0,0 +1,64 @@
+name: "Builtins: break and continue"
+cases:
+  - name: "Break outside loop"
+    ignore_stderr: true
+    stdin: |
+      if true; then
+        break
+      fi
+      echo "status: $?"
+
+  - name: "Break outside loop in script"
+    ignore_stderr: true
+    test_files:
+      - path: "script.sh"
+        contents: |
+          if true; then
+            break
+          fi
+          echo "status: $?"
+    args: ["./script.sh"]
+
+  - name: "Continue outside loop"
+    ignore_stderr: true
+    stdin: |
+      continue
+      echo "status: $?"
+
+  - name: "Break in function called from loop"
+    ignore_stderr: true
+    stdin: |
+      f() { break; }
+      for i in 1 2; do
+        f
+        echo "i=$i"
+      done
+
+  - name: "Break in subshell inside loop"
+    ignore_stderr: true
+    stdin: |
+      for i in 1 2; do
+        (break; echo "in subshell")
+        echo "i=$i"
+      done
+
+  - name: "Break more levels than loops"
+    stdin: |
+      for i in 1 2; do
+        for j in a b; do
+          break 5
+        done
+        echo "not reached"
+      done
+      echo "after loops"
+
+  - name: "Continue more levels than loops"
+    stdin: |
+      for i in 1 2; do
+        for j in a b; do
+          continue 5
+          echo "not reached"
+        done
+        echo "not reached"
+      done
+      echo "i=$i"
