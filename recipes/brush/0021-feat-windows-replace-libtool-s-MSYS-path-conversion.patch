diff --git a/brush-core/src/compat/libtool-2.6-convert-core-msys-to-w32.sh b/brush-core/src/compat/libtool-2.6-convert-core-msys-to-w32.sh
new file mode 100644
index 00000000..71d1815c
--- /dev/null
+++ b/brush-core/src/compat/libtool-2.6-convert-core-msys-to-w32.sh
@@ -0,0 +1,17 @@
+func_convert_core_msys_to_w32 ()
+{
+  $debug_cmd
+
+  # Compatibility for original MSYS
+  if test "Xone" = "X$lt_cv_cmd_slashes"; then
+  func_convert_core_msys_to_w32_result=`( cmd /c echo "$1" ) 2>/dev/null |
+    $SED -e 's/[ ]*$//' -e "$sed_naive_backslashify"`
+  else # Assume 'lt_cv_cmd_slashes = "two"'
+  func_convert_core_msys_to_w32_result=`( cmd //c echo "$1" ) 2>/dev/null |
+    $SED -e 's/[ ]*$//' -e "$sed_naive_backslashify"`
+  fi
+  if test "$?" -ne 0; then
+      # on failure, ensure result is empty
+      func_convert_core_msys_to_w32_result=
+  fi
+}
