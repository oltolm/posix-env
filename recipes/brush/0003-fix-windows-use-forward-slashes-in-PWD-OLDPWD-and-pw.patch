From 4d5d4259b34fad0710e87c54e014d3b2b2f308f8 Mon Sep 17 00:00:00 2001
From: Oleg Tolmatcev <oleg.tolmatcev@gmail.com>
Date: Thu, 1 Oct 2026 17:00:53 +0200
Subject: [PATCH 03/21] fix(windows): use forward slashes in PWD, OLDPWD and
 pwd

Scripts splice these values into sed replacements, eval and case
patterns, where `\` is an escape character; configure's $ac_pwd and
$srcdir came out mangled.

Render them with `/` separators (as `cygpath -m` does) and drop the
`\\?\` prefix that canonicalization adds for `pwd -P`.

Assisted-by: Claude Code:claude-opus-5-5
---
 brush-builtins/src/pwd.rs       |  6 ++++-
 brush-core/src/shell/fs.rs      |  4 +--
 brush-core/src/sys/fs.rs        | 48 +++++++++++++++++++++++++++++++++
 brush-core/src/wellknownvars.rs |  2 +-
 4 files changed, 56 insertions(+), 4 deletions(-)

diff --git a/brush-builtins/src/pwd.rs b/brush-builtins/src/pwd.rs
index 09f9cadc..cbff6fba 100644
--- a/brush-builtins/src/pwd.rs
+++ b/brush-builtins/src/pwd.rs
@@ -33,7 +33,11 @@ impl builtins::Command for PwdCommand {
             cwd = cwd.canonicalize()?.into();
         }
 
-        writeln!(context.stdout(), "{}", cwd.to_string_lossy())?;
+        writeln!(
+            context.stdout(),
+            "{}",
+            brush_core::sys::fs::path_to_shell_string(&cwd)
+        )?;
 
         Ok(ExecutionResult::success())
     }
diff --git a/brush-core/src/shell/fs.rs b/brush-core/src/shell/fs.rs
index 33ffe30d..0228314b 100644
--- a/brush-core/src/shell/fs.rs
+++ b/brush-core/src/shell/fs.rs
@@ -35,7 +35,7 @@ impl<SE: crate::extensions::ShellExtensions> crate::Shell<SE> {
         // Normalize the path (but don't canonicalize it).
         let cleaned_path = abs_path.normalize();
 
-        let pwd = cleaned_path.to_string_lossy().to_string();
+        let pwd = crate::sys::fs::path_to_shell_string(&cleaned_path);
 
         self.env.update_or_add(
             "PWD",
@@ -48,7 +48,7 @@ impl<SE: crate::extensions::ShellExtensions> crate::Shell<SE> {
 
         self.env.update_or_add(
             "OLDPWD",
-            variables::ShellValueLiteral::Scalar(oldpwd.to_string_lossy().to_string()),
+            variables::ShellValueLiteral::Scalar(crate::sys::fs::path_to_shell_string(&oldpwd)),
             |_| Ok(()),
