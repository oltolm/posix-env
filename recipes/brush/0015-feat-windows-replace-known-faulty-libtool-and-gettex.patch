diff --git a/brush-core/src/compat.rs b/brush-core/src/compat.rs
new file mode 100644
index 00000000..c97fbf31
--- /dev/null
+++ b/brush-core/src/compat.rs
@@ -0,0 +1,137 @@
+//! Compatibility shims for generated build scripts.
+//!
+//! Some widely copied shell code from libtool and gettext takes only "/..." as an
+//! absolute path, and fails on the drive-letter paths a native Windows shell
+//! uses. Every source tree and release tarball carries its own copy, so the
+//! shell recognizes the exact faulty code and runs a fixed version instead.
+//! Matching compares the code's normalized form, which ignores comments and
+//! indentation, so one entry covers copies that differ only in those.
+
+use std::sync::OnceLock;
+
+use brush_parser::ast;
+
+use crate::trace_categories;
+
+/// Faulty code and its replacement.
+struct Shim {
+    faulty: &'static str,
+    fixed: &'static str,
+}
+
+/// Function definitions to replace.
+const FUNCTIONS: &[Shim] = &[
+    // libtool 2.2: func_normal_abspath never terminates on a C:/ path.
+    Shim {
+        faulty: include_str!("compat/libtool-2.2-normal-abspath.sh"),
+        fixed: include_str!("compat/libtool-2.2-normal-abspath-fixed.sh"),
+    },
+    // libtool 2.4 to 2.6: the same bug.
+    Shim {
+        faulty: include_str!("compat/libtool-2.4-normal-abspath.sh"),
+        fixed: include_str!("compat/libtool-2.4-normal-abspath-fixed.sh"),
+    },
+];
+
+/// Case commands to replace.
+const CASES: &[Shim] = &[
+    // gettext AM_PO_SUBDIRS (config.status): a C:/ srcdir is made relative, so
+    // po/POTFILES lists ../C:/... paths.
+    Shim {
+        faulty: include_str!("compat/gettext-po-srcdir.sh"),
+        fixed: include_str!("compat/gettext-po-srcdir-fixed.sh"),
+    },
+];
+
+/// A parsed shim: a cheap key to filter candidates, the faulty code's
+/// normalized form, and the replacement.
+struct Parsed<T> {
+    key: String,
+    faulty: String,
+    fixed: T,
+}
+
+fn parse_command(text: &str) -> ast::Command {
+    let mut parser =
+        brush_parser::Parser::new(text.as_bytes(), &brush_parser::ParserOptions::default());
+    #[allow(clippy::expect_used)]
+    let program = parser.parse_program().expect("compat shim must parse");
+    program
+        .complete_commands
+        .into_iter()
+        .next()
+        .and_then(|list| list.0.into_iter().next())
+        .and_then(|item| item.0.first.seq.into_iter().next())
+        .unwrap_or_else(|| unreachable!("compat shim must hold a command"))
+}
+
+fn parse_function(text: &str) -> ast::FunctionDefinition {
+    match parse_command(text) {
+        ast::Command::Function(def) => def,
+        _ => unreachable!("compat shim must be a function definition"),
+    }
+}
+
+fn parse_case(text: &str) -> ast::CaseClauseCommand {
+    match parse_command(text) {
+        ast::Command::Compound(ast::CompoundCommand::CaseClause(cmd), None) => cmd,
+        _ => unreachable!("compat shim must be a case command"),
+    }
+}
+
+fn functions() -> &'static [Parsed<ast::FunctionDefinition>] {
+    static PARSED: OnceLock<Vec<Parsed<ast::FunctionDefinition>>> = OnceLock::new();
+    PARSED.get_or_init(|| {
+        FUNCTIONS
+            .iter()
+            .map(|shim| {
+                let faulty = parse_function(shim.faulty);
+                Parsed {
+                    key: faulty.fname.value.clone(),
+                    faulty: faulty.to_string(),
+                    fixed: parse_function(shim.fixed),
+                }
+            })
+            .collect()
+    })
+}
+
+fn cases() -> &'static [Parsed<ast::CaseClauseCommand>] {
+    static PARSED: OnceLock<Vec<Parsed<ast::CaseClauseCommand>>> = OnceLock::new();
+    PARSED.get_or_init(|| {
+        CASES
+            .iter()
+            .map(|shim| {
+                let faulty = parse_case(shim.faulty);
+                Parsed {
+                    key: faulty.value.value.clone(),
+                    faulty: faulty.to_string(),
+                    fixed: parse_case(shim.fixed),
+                }
+            })
+            .collect()
+    })
+}
+
+fn find<'a, T>(shims: &'a [Parsed<T>], key: &str, node: &impl ToString) -> Option<&'a T> {
+    let mut candidates = shims.iter().filter(|shim| shim.key == key).peekable();
+    candidates.peek()?;
+    let text = node.to_string();
+    let shim = candidates.find(|shim| shim.faulty == text)?;
+    tracing::debug!(target: trace_categories::COMMANDS, "compat: replacing known-faulty code:\n{text}");
+    Some(&shim.fixed)
+}
+
+/// Returns the replacement for a known-faulty function definition.
+pub(crate) fn function_replacement(
+    def: &ast::FunctionDefinition,
+) -> Option<&'static ast::FunctionDefinition> {
+    find(functions(), &def.fname.value, def)
+}
+
+/// Returns the replacement for a known-faulty case command.
+pub(crate) fn case_replacement(
+    cmd: &ast::CaseClauseCommand,
+) -> Option<&'static ast::CaseClauseCommand> {
+    find(cases(), &cmd.value.value, cmd)
+}
