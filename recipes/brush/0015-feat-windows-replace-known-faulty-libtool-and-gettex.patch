+//! Integration tests for the shims that replace known-faulty code from generated
+//! build scripts with code that handles drive-letter paths.
+
+#![cfg(windows)]
+#![cfg(test)]
+#![allow(clippy::panic_in_result_fn, clippy::expect_used)]
+
+use anyhow::Result;
+
+async fn run(shell: &mut brush_core::Shell, script: &str) -> Result<()> {
+    let params = shell.default_exec_params();
+    shell
+        .run_string(script, &brush_core::SourceInfo::default(), &params)
+        .await?;
+    Ok(())
+}
+
+async fn defined_as(faulty: &str, expected: &str) -> Result<()> {
+    let mut shell = brush_core::Shell::builder().build().await?;
+    run(&mut shell, faulty).await?;
+    let defined = shell
+        .funcs()
+        .get("func_normal_abspath")
+        .expect("function not defined")
+        .definition()
+        .to_string();
+
+    let mut reference = brush_core::Shell::builder().build().await?;
+    run(&mut reference, expected).await?;
+    let expected = reference
+        .funcs()
+        .get("func_normal_abspath")
+        .expect("function not defined")
+        .definition()
+        .to_string();
+
+    assert_eq!(defined, expected);
+    Ok(())
+}
+
+/// libtool 2.2's `func_normal_abspath` never terminates on C:/ paths.
+#[tokio::test]
+async fn libtool_2_2_normal_abspath_is_replaced() -> Result<()> {
+    defined_as(
+        include_str!("../src/compat/libtool-2.2-normal-abspath.sh"),
+        include_str!("../src/compat/libtool-2.2-normal-abspath-fixed.sh"),
+    )
+    .await
+}
+
+/// libtool 2.4 to 2.6 have the same bug in a rewritten `func_normal_abspath`.
+#[tokio::test]
+async fn libtool_2_4_normal_abspath_is_replaced() -> Result<()> {
+    defined_as(
+        include_str!("../src/compat/libtool-2.4-normal-abspath.sh"),
+        include_str!("../src/compat/libtool-2.4-normal-abspath-fixed.sh"),
+    )
+    .await
+}
+
+/// A function that merely shares the name keeps its own body.
+#[tokio::test]
+async fn other_normal_abspath_is_kept() -> Result<()> {
+    let own = "func_normal_abspath () { func_normal_abspath_result=$1; }\n";
+    defined_as(own, own).await
+}
+
+/// gettext's `AM_PO_SUBDIRS` takes only /... for an absolute srcdir.
+#[tokio::test]
+async fn gettext_po_srcdir_accepts_drive_letter() -> Result<()> {
+    let mut shell = brush_core::Shell::builder().build().await?;
+    run(
+        &mut shell,
+        &format!(
+            "ac_given_srcdir=C:/src/binutils-gdb/bfd ac_dots=../\n{}",
+            include_str!("../src/compat/gettext-po-srcdir.sh")
+        ),
+    )
+    .await?;
+    assert_eq!(
+        shell.env_str("top_srcdir").as_deref(),
+        Some("C:/src/binutils-gdb/bfd")
+    );
+    Ok(())
+}
+
+/// The relative srcdir case is unchanged.
+#[tokio::test]
+async fn gettext_po_srcdir_relative() -> Result<()> {
+    let mut shell = brush_core::Shell::builder().build().await?;
+    run(
+        &mut shell,
+        &format!(
+            "ac_given_srcdir=../../src/bfd ac_dots=../\n{}",
+            include_str!("../src/compat/gettext-po-srcdir.sh")
+        ),
+    )
+    .await?;
+    assert_eq!(
+        shell.env_str("top_srcdir").as_deref(),
+        Some("../../../src/bfd")
+    );
+    Ok(())
+}
