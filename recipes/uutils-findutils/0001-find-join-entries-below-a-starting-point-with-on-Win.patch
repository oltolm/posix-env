+/// `./NAME`, as GNU find passes it to -execdir commands; `Path::join` would
+/// produce `.\\NAME` on Windows.
+fn dot_slash(path: &Path) -> PathBuf {
+    if matches!(
+        path.components().next(),
+        Some(Component::Prefix(_) | Component::RootDir)
+    ) {
+        return Path::new(".").join(path);
+    }
+    let mut s = OsString::from("./");
+    s.push(path);
+    s.into()
+}
