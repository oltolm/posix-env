+/// Like GNU find, name entries below a starting point by appending `/` and
+/// the file name. walkdir joins them with `\` on Windows, which scripts that
+/// paste find's output into `eval` or sed (libtool does) cannot handle.
+#[cfg(windows)]
+fn reported_path(path: &Path, depth: usize) -> Option<PathBuf> {
+    let s = path.to_str()?;
+    // Windows file names cannot contain `\`, so the last `depth` backslashes
+    // are exactly the separators walkdir added below the starting point.
+    let mut bytes = s.as_bytes().to_vec();
+    let mut left = depth;
+    for b in bytes.iter_mut().rev() {
+        if left == 0 {
+            break;
+        }
+        if *b == b'\\' {
+            *b = b'/';
+            left -= 1;
+        }
+    }
+    if left != 0 {
+        return None;
+    }
+    String::from_utf8(bytes).ok().map(PathBuf::from)
+}
+
+#[cfg(not(windows))]
+fn reported_path(_path: &Path, _depth: usize) -> Option<PathBuf> {
+    None
 }
 
