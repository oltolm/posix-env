Subject: [PATCH 3/3] Do not pass global LDFLAGS twice

Automake and libtool already add LDFLAGS to the library link command.
Repeating it in libtre_la_LDFLAGS duplicates object files carried in the
native environment's global flags.

--- a/lib/Makefile.am
+++ b/lib/Makefile.am
@@ -1,6 +1,6 @@
 ## Process this file with automake to produce Makefile.in
 lib_LTLIBRARIES = libtre.la
-libtre_la_LDFLAGS = -no-undefined -version-info 5:0:0 $(LDFLAGS)
+libtre_la_LDFLAGS = -no-undefined -version-info 5:0:0
 libtre_la_LIBADD = $(LTLIBINTL)
 AM_CPPFLAGS = -I$(top_srcdir)/include/tre
 
