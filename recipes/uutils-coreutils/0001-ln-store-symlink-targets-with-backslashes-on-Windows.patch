diff --git a/src/uucore/src/lib/features/fs.rs b/src/uucore/src/lib/features/fs.rs
index 221d03873..9a8516f29 100644
--- a/src/uucore/src/lib/features/fs.rs
+++ b/src/uucore/src/lib/features/fs.rs
@@ -1243,11 +1243,7 @@ fn create_link_std(target: &Path, dest: &Path, symbolic: bool) -> IOResult<()> {
     }
     #[cfg(windows)]
     {
-        if target.is_dir() {
-            std::os::windows::fs::symlink_dir(target, dest)
-        } else {
-            std::os::windows::fs::symlink_file(target, dest)
-        }
+        symlink(target, dest)
     }
     #[cfg(target_os = "redox")]
     {
@@ -1259,6 +1255,42 @@ fn create_link_std(target: &Path, dest: &Path, symbolic: bool) -> IOResult<()> {
     }
 }
 
+#[cfg(windows)]
+fn windows_link_target(src: &Path) -> PathBuf {
+    use std::os::windows::ffi::{OsStrExt, OsStringExt};
+    let wide: Vec<u16> = src
+        .as_os_str()
+        .encode_wide()
+        .map(|c| {
+            if c == u16::from(b'/') {
+                u16::from(b'\\')
+            } else {
+                c
+            }
+        })
+        .collect();
+    PathBuf::from(OsString::from_wide(&wide))
+}
+
+/// Create a symbolic link at `dest` to `target`, as a directory link if
+/// `target` is a directory.
+///
+/// Windows does not resolve a relative target containing `/`, so the link
+/// would dangle; the target is stored with `\` instead.
+///
+/// # Errors
+///
+/// Returns an error if the link cannot be created.
+#[cfg(windows)]
+pub fn symlink(target: &Path, dest: &Path) -> IOResult<()> {
+    let target = windows_link_target(target);
+    if target.is_dir() {
+        std::os::windows::fs::symlink_dir(&target, dest)
+    } else {
+        std::os::windows::fs::symlink_file(&target, dest)
+    }
+}
+
 #[cfg(test)]
 mod tests {
     // Note this useful idiom: importing names from outer (for mod tests) scope.
@@ -1270,6 +1302,19 @@ mod tests {
     #[cfg(unix)]
     use tempfile::{NamedTempFile, tempdir};
 
+    #[cfg(windows)]
+    #[test]
+    fn link_target_uses_backslashes() {
+        assert_eq!(
+            windows_link_target(Path::new("test/dir/file")),
+            PathBuf::from("test\\dir\\file")
+        );
+        assert_eq!(
+            windows_link_target(Path::new("..\\up/mixed\\sep/file")),
+            PathBuf::from("..\\up\\mixed\\sep\\file")
+        );
+    }
+
     // Keep fixtures outside the crate so Cargo's concurrent doctest/build-script
     // scans cannot race their removal. WASI needs the preopened current directory
     // because `std::env::temp_dir` aborts there.
diff --git a/tests/by-util/test_ln.rs b/tests/by-util/test_ln.rs
index 52e454369..2974bf1fa 100644
--- a/tests/by-util/test_ln.rs
+++ b/tests/by-util/test_ln.rs
@@ -98,6 +98,35 @@ fn test_symlink_dangling_directory() {
     assert_eq!(at.resolve_link(link), dir);
 }
 
+// On Windows, a stored relative target with `/` does not resolve.
+#[test]
+fn test_symlink_relative_target_with_slash_resolves() {
+    let (at, mut ucmd) = at_and_ucmd!();
+    at.mkdir("a");
+    at.mkdir("b");
+    at.write("a/file", "content");
+
+    ucmd.args(&["-s", "../a/file", "b/link"])
+        .succeeds()
+        .no_stderr();
+    assert_eq!(at.read("b/link"), "content");
+}
+
+// Same, through the replacement path taken by -f.
+#[test]
+fn test_symlink_force_relative_target_with_slash_resolves() {
+    let (at, mut ucmd) = at_and_ucmd!();
+    at.mkdir("a");
+    at.mkdir("b");
+    at.write("a/file", "content");
+    at.touch("b/link");
+
+    ucmd.args(&["-sf", "../a/file", "b/link"])
+        .succeeds()
+        .no_stderr();
+    assert_eq!(at.read("b/link"), "content");
+}
+
 #[test]
 fn test_symlink_circular() {
     let (at, mut ucmd) = at_and_ucmd!();
