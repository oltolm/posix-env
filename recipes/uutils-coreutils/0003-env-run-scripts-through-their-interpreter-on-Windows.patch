diff --git a/src/uu/env/src/env.rs b/src/uu/env/src/env.rs
index 02505edbe..7c2486fad 100644
--- a/src/uu/env/src/env.rs
+++ b/src/uu/env/src/env.rs
@@ -922,7 +922,24 @@ impl EnvAppData {
             let mut cmd = std::process::Command::new(&*prog);
             cmd.args(args);
 
-            match cmd.status() {
+            let status = match cmd.status() {
+                // Windows cannot run a #! script itself: run its interpreter.
+                #[cfg(windows)]
+                Err(e)
+                    if matches!(
+                        e.kind(),
+                        io::ErrorKind::NotFound | io::ErrorKind::InvalidInput
+                    ) || e.raw_os_error() == Some(ERROR_BAD_EXE_FORMAT) =>
+                {
+                    match script::command(&prog) {
+                        Some(mut cmd) => cmd.args(args).status(),
+                        None => Err(e),
+                    }
+                }
+                status => status,
+            };
+
+            match status {
                 Ok(exit) if !exit.success() => Err(exit.code().unwrap_or(1).into()),
                 Err(e)
                     if matches!(
@@ -1240,6 +1257,140 @@ pub fn uumain(args: impl uucore::Args) -> UResult<()> {
     EnvAppData::default().run_env(args)
 }
 
+/// `CreateProcess` fails with this for a file that is no executable.
+#[cfg(windows)]
+const ERROR_BAD_EXE_FORMAT: i32 = 193;
+
+/// Running `#!` scripts on Windows.
+///
+/// Windows cannot execute scripts itself, but programs written for POSIX run
+/// them through `env` (libtool's `env VAR=... SCRIPT`). POSIX interpreter
+/// paths such as `/bin/sh` do not exist on Windows, so only the interpreter's
+/// file name is kept and looked up in `PATH`; `#!/usr/bin/env NAME` names it
+/// in its argument.
+#[cfg(windows)]
+mod script {
+    use std::ffi::{OsStr, OsString};
+    use std::io::{BufRead as _, BufReader, Read as _};
+    use std::path::Path;
+    use std::process::Command;
+
+    /// Returns the command that runs the `#!` script `prog`, if it is one.
+    ///
+    /// `prog` is a path if it contains a directory separator, and is looked
+    /// up in `PATH` otherwise.
+    pub fn command(prog: &OsStr) -> Option<Command> {
+        let (script, interp, arg) = find(prog)?;
+        let mut cmd = Command::new(interp);
+        cmd.args(arg);
+        cmd.arg(script);
+        Some(cmd)
+    }
+
+    fn find(prog: &OsStr) -> Option<(OsString, String, Option<String>)> {
+        let with_interp = |script: OsString| {
+            let (interp, arg) = interpreter(Path::new(&script))?;
+            Some((script, interp, arg))
+        };
+        if prog
+            .as_encoded_bytes()
+            .iter()
+            .any(|&b| b == b'/' || b == b'\\')
+        {
+            return with_interp(prog.to_owned());
+        }
+        // Joined with '/', as the shell spells PATH entries, so that the
+        // script's $0 has no backslashes.
+        let path = std::env::var_os("PATH")?;
+        std::env::split_paths(&path)
+            .filter(|dir| !dir.as_os_str().is_empty())
+            .find_map(|dir| {
+                let mut script = dir.into_os_string();
+                if !script.as_encoded_bytes().ends_with(b"/")
+                    && !script.as_encoded_bytes().ends_with(b"\\")
+                {
+                    script.push("/");
+                }
+                script.push(prog);
+                with_interp(script)
+            })
+    }
+
+    /// Returns the interpreter's file name and its optional argument for the
+    /// `#!` script `path`.
+    pub fn interpreter(path: &Path) -> Option<(String, Option<String>)> {
+        if !path.is_file() {
+            return None;
+        }
+        let mut line = Vec::new();
+        BufReader::new(std::fs::File::open(path).ok()?)
+            .take(4096)
+            .read_until(b'\n', &mut line)
+            .ok()?;
+        let line = String::from_utf8_lossy(line.strip_prefix(b"#!")?);
+        let (interp, arg) = split_word(line.trim());
+        let name = interp.rsplit(['/', '\\']).next().unwrap_or(interp);
+        match arg {
+            Some(arg) if name == "env" => {
+                let arg = arg.strip_prefix("-S").map_or(arg, str::trim_start);
+                let (name, rest) = split_word(arg);
+                Some((name.to_string(), rest.map(str::to_string)))
+            }
+            _ => Some((name.to_string(), arg.map(str::to_string))),
+        }
+    }
+
+    /// Splits off the first word; the rest, if any, is one argument.
+    fn split_word(s: &str) -> (&str, Option<&str>) {
+        match s.split_once([' ', '\t']) {
+            Some((word, rest)) if !rest.trim().is_empty() => (word, Some(rest.trim())),
+            _ => (s.trim(), None),
+        }
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::interpreter;
+
+        fn script(contents: &str) -> Option<(String, Option<String>)> {
+            use std::sync::atomic::{AtomicUsize, Ordering};
+            static N: AtomicUsize = AtomicUsize::new(0);
+            let path = std::env::temp_dir().join(format!(
+                "uu-env-script-{}-{}",
+                std::process::id(),
+                N.fetch_add(1, Ordering::Relaxed)
+            ));
+            std::fs::write(&path, contents).unwrap();
+            let result = interpreter(&path);
+            std::fs::remove_file(&path).unwrap();
+            result
+        }
+
+        #[test]
+        fn keeps_file_name_and_argument() {
+            assert_eq!(script("#!/bin/sh\necho hi\n"), Some(("sh".into(), None)));
+            assert_eq!(
+                script("#! /bin/bash -e\r\n"),
+                Some(("bash".into(), Some("-e".into())))
+            );
+            assert_eq!(
+                script("#!/usr/bin/env perl -w\n"),
+                Some(("perl".into(), Some("-w".into())))
+            );
+            assert_eq!(
+                script("#!/usr/bin/env -S perl\n"),
+                Some(("perl".into(), None))
+            );
+        }
+
+        #[test]
+        fn ignores_other_files() {
+            assert_eq!(script("plain text\n"), None);
+            assert_eq!(script(""), None);
+        }
+    }
+}
+
