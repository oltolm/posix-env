--- a/tests/by-util/test_env.rs
+++ b/tests/by-util/test_env.rs
@@ -179,6 +179,40 @@ fn test_if_windows_batch_files_can_be_executed() {
     assert!(result.stdout_str().contains("Hello Windows World!"));
 }
 
+/// Windows cannot run `#!` scripts; env runs their interpreter, looked up by
+/// file name in PATH, with the script and its arguments.
+#[cfg(all(windows, feature = "echo"))]
+#[test]
+fn test_shebang_scripts_run_through_their_interpreter() {
+    let ts = TestScenario::new(util_name!());
+    let at = &ts.fixtures;
+    let bin_dir = ts.bin_path.parent().unwrap().to_str().unwrap().to_string();
+    at.write("by-path", "#!/usr/local/bin/coreutils echo\r\n");
+    at.mkdir("dir");
+    at.write("dir/in-path", "#!/usr/bin/env coreutils echo\n");
+    let path = format!("{bin_dir};{}", at.plus_as_string("dir"));
+
+    ts.ucmd()
+        .env("PATH", &path)
+        .args(&["./by-path", "a b"])
+        .succeeds()
+        .stdout_only("./by-path a b\n");
+    let out = ts
+        .ucmd()
+        .env("PATH", &path)
+        .args(&["in-path", "x"])
+        .succeeds()
+        .stdout_move_str();
+    assert!(out.ends_with("dir/in-path x\n"), "{out:?}");
+
+    // Not a script: found, but cannot be invoked.
+    at.write("text", "plain\n");
+    ts.ucmd()
+        .env("PATH", &path)
+        .arg("./text")
+        .fails_with_code(126);
+}
