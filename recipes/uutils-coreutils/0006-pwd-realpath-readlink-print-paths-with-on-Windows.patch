diff --git a/src/uucore/src/lib/features/fs.rs b/src/uucore/src/lib/features/fs.rs
index b5bdd3f..c4ac899 100644
--- a/src/uucore/src/lib/features/fs.rs
+++ b/src/uucore/src/lib/features/fs.rs
@@ -250,6 +250,31 @@ pub enum ResolveMode {
     Logical,
 }
 
+/// A path to print for scripts: on Windows with `/` separators, which
+/// Windows accepts too.  A printed `C:\src\build` breaks the scripts that
+/// read it as POSIX shell or Tcl words (`\s` and `\b` are escapes there);
+/// gcc's Makefile writes `$(shell pwd)` into its testsuite's site.exp.
+pub fn posix_separators(path: &Path) -> std::borrow::Cow<'_, Path> {
+    #[cfg(windows)]
+    {
+        let wide: Vec<u16> = path.as_os_str().encode_wide().collect();
+        if wide.contains(&u16::from(b'\\')) {
+            let wide: Vec<u16> = wide
+                .into_iter()
+                .map(|c| {
+                    if c == u16::from(b'\\') {
+                        u16::from(b'/')
+                    } else {
+                        c
+                    }
+                })
+                .collect();
+            return std::borrow::Cow::Owned(PathBuf::from(OsString::from_wide(&wide)));
+        }
+    }
+    std::borrow::Cow::Borrowed(path)
+}
+
 /// Normalize a path by removing relative information
 /// For example, convert 'bar/../foo/bar.txt' => 'foo/bar.txt'
 /// copied from `<https://github.com/rust-lang/cargo/blob/2e4cfc2b7d43328b207879228a2ca7d427d188bb/src/cargo/util/paths.rs#L65-L90>`
