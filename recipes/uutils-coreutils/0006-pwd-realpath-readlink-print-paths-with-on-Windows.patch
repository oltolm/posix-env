 tests/by-util/test_pwd.rs         |  41 ++++++---
 tests/by-util/test_readlink.rs    |  60 +++++++------
 tests/by-util/test_realpath.rs    | 143 +++++++++++++++++-------------
 8 files changed, 177 insertions(+), 103 deletions(-)

