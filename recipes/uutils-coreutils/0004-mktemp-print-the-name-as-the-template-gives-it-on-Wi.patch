From e63146fed697c0fc529ee9daa96c011bf0cd3f0e Mon Sep 17 00:00:00 2001
From: Oleg Tolmatcev <oleg.tolmatcev@gmail.com>
Date: Tue, 6 Oct 2026 19:25:10 +0200
Subject: [PATCH] mktemp: print the name as the template gives it on Windows

Path::join put a backslash between the template's directory and the
random name: "mktemp -d ./confXXXXXX" printed ".\confAbc123", which
autoconf 2.59's config.status lost in eval (Tcl's configure).  The name
is now the directory and template as given, with the separator they
use.
---
 src/uu/mktemp/src/mktemp.rs  | 54 ++++++++++++++++++++++++++++++++++--
 tests/by-util/test_mktemp.rs | 19 +++++++++++++
 2 files changed, 70 insertions(+), 3 deletions(-)

diff --git a/src/uu/mktemp/src/mktemp.rs b/src/uu/mktemp/src/mktemp.rs
index 887798c..8c9feb5 100644
--- a/src/uu/mktemp/src/mktemp.rs
+++ b/src/uu/mktemp/src/mktemp.rs
@@ -189,6 +189,14 @@ struct Params {
 
     /// The (non-random) suffix of the temporary file.
     suffix: String,
+
+    /// The name to print up to the random characters: the directory and
+    /// the template as given, joined with the separator they use.  On
+    /// Windows, `Path::join` would put a backslash between "." and the
+    /// rest of "./confXXXXXX", which scripts that split at '/' or that
+    /// `eval` the name cannot use.
+    #[cfg(windows)]
+    display_prefix: String,
 }
 
 /// Find the start and end indices of the last contiguous block of Xs.
@@ -289,7 +297,7 @@ impl Params {
                 // return wrong results for hidden files like /tmp/.XXXXXXXX.
                 // Use prefix_from_template directly instead.
                 let directory = Path::new(&prefix_from_option)
-                    .join(&prefix_from_template[..prefix_from_template.len() - 1]); // strip trailing '.'
+                    .join(&prefix_from_template[..prefix_from_template.len() - 1]); // strip trailing '.'\\'
 
                 let prefix = ".".to_string();
 
@@ -327,11 +335,30 @@ impl Params {
         // random characters is four.
         let num_rand_chars = j - i;
 
+        #[cfg(windows)]
+        let display_prefix = match &tmpdir {
+            None => prefix_from_template.to_string(),
+            Some(dir) => {
+                let dir = dir.to_string_lossy();
+                if dir.is_empty() || dir.ends_with(['/', '\\']) {
+                    format!("{dir}{prefix_from_template}")
+                } else {
+                    let uses_backslash = !dir.contains('/')
+                        && !prefix_from_template.contains('/')
+                        && (dir.contains('\\') || prefix_from_template.contains('\\'));
+                    let sep = if uses_backslash { '\\' } else { '/' };
+                    format!("{dir}{sep}{prefix_from_template}")
+                }
+            }
+        };
+
         Ok(Self {
             directory,
             prefix,
             num_rand_chars,
             suffix,
+            #[cfg(windows)]
+            display_prefix,
         })
     }
 }
@@ -423,6 +450,8 @@ pub fn uumain(args: impl uucore::Args) -> UResult<()> {
         prefix,
         num_rand_chars: rand,
         suffix,
+        #[cfg(windows)]
+        display_prefix,
     } = Params::from(options)?;
 
     // Create the temporary file or directory, or simulate creating it.
@@ -431,6 +460,8 @@ pub fn uumain(args: impl uucore::Args) -> UResult<()> {
     } else {
         exec(&tmpdir, &prefix, rand, &suffix, make_dir)
     };
+    #[cfg(windows)]
+    let res = res.map(|path| display_name(&path, &prefix, &display_prefix));
 
     let res = if suppress_file_err {
         // Mapping all UErrors to ExitCodes prevents the errors from being printed
@@ -666,14 +697,31 @@ pub fn mktemp(options: &Options) -> UResult<PathBuf> {
         prefix,
         num_rand_chars: rand,
         suffix,
+        #[cfg(windows)]
+        display_prefix,
     } = Params::from(options.clone())?;
 
     // Create the temporary file or directory, or simulate creating it.
-    if options.dry_run {
+    let res = if options.dry_run {
         Ok(dry_exec(&tmpdir, &prefix, rand, &suffix))
     } else {
         exec(&tmpdir, &prefix, rand, &suffix, options.directory)
-    }
+    };
+
+    #[cfg(windows)]
+    let res = res.map(|path| display_name(&path, &prefix, &display_prefix));
+
+    res
+}
+
+/// The name to print for a created `path`, as the directory and template
+/// were given: `display_prefix`, then the random characters and the suffix
+/// (the file name after `prefix`).
+#[cfg(windows)]
+fn display_name(path: &Path, prefix: &str, display_prefix: &str) -> PathBuf {
+    let name = path.file_name().unwrap_or_default().to_string_lossy();
+    let random_and_suffix = name.strip_prefix(prefix).unwrap_or(&name);
+    PathBuf::from(format!("{display_prefix}{random_and_suffix}"))
 }
 
 #[cfg(test)]
diff --git a/tests/by-util/test_mktemp.rs b/tests/by-util/test_mktemp.rs
index 7187b5b..5b146ff 100644
--- a/tests/by-util/test_mktemp.rs
+++ b/tests/by-util/test_mktemp.rs
@@ -1269,3 +1269,22 @@ fn test_write_error_removes_the_temporary_directory() {
         .collect();
     assert!(leftovers.is_empty(), "left behind: {leftovers:?}");
 }
+
+/// The name is printed as the template gives it: "./confXXXXXX" stays
+/// "./conf...", not ".\conf..." (scripts split it at '/' or `eval` it).
+#[cfg(windows)]
+#[test]
+fn test_template_keeps_forward_slashes() {
+    let (at, mut ucmd) = at_and_ucmd!();
+    let result = ucmd.args(&["-d", "./confXXXXXX"]).succeeds();
+    let dirname = result.no_stderr().stdout_str().trim_end();
+    assert_matches_template!("./confXXXXXX", dirname);
+    assert!(at.dir_exists(dirname));
+
+    let (at, mut ucmd) = at_and_ucmd!();
+    at.mkdir("a");
+    let result = ucmd.args(&["-p", ".", "a/bXXXX"]).succeeds();
+    let filename = result.no_stderr().stdout_str().trim_end();
+    assert_matches_template!("./a/bXXXX", filename);
+    assert!(at.file_exists(filename));
+}
-- 
