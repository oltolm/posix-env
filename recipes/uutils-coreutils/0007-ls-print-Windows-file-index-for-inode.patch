diff --git a/tests/by-util/test_ls.rs b/tests/by-util/test_ls.rs
--- a/tests/by-util/test_ls.rs
+++ b/tests/by-util/test_ls.rs
@@ -3592,6 +3592,33 @@ fn test_ls_inode() {
     assert_eq!(inode_short, inode_long);
