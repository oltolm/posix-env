+#[cfg(windows)]
+#[test]
+fn test_ls_inode_uses_windows_file_index() {
+    let scene = TestScenario::new(util_name!());
+    let at = &scene.fixtures;
+
+    at.touch("inode-a");
+    std::fs::hard_link(at.plus("inode-a"), at.plus("inode-b")).unwrap();
+
+    let result = scene
+        .ucmd()
+        .args(&["-i", "inode-a", "inode-b"])
+        .succeeds();
+    let mut lines = result.stdout_str().lines();
+    let inode = |line: &str| {
+        line.split_whitespace()
+            .next()
+            .unwrap()
+            .parse::<u64>()
+            .unwrap()
+    };
+    let inode_a = inode(lines.next().unwrap());
+    let inode_b = inode(lines.next().unwrap());
+    assert_ne!(inode_a, 0);
+    assert_eq!(inode_a, inode_b);
+}
