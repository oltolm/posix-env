 src/uu/ls/src/display.rs   | 40 ++++++++++++++++++++++++++++++----------
 tests/by-util/test_ls.rs   | 27 +++++++++++++++++++++++++++
 3 files changed, 62 insertions(+), 13 deletions(-)

