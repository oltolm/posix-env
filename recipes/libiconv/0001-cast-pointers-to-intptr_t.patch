Cast pointers to intptr_t, not long: long is 32 bits on 64-bit Windows.
From MSYS2's mingw-w64-libiconv.

diff --git a/lib/genaliases.c b/lib/genaliases.c
index 8260681..4ada68c 100644
--- a/lib/genaliases.c
+++ b/lib/genaliases.c
@@ -60,7 +60,7 @@ static void emit_encoding (FILE* out1, FILE* out2, const char* const* names, siz
       putc(c, out2);
     }
   }
-  fprintf(out2,"\")' tmp.h | sed -e 's|^.*\\(stringpool_str[0-9]*\\).*$|  (int)(long)\\&((struct stringpool_t *)0)->\\1,|'\n");
+  fprintf(out2,"\")' tmp.h | sed -e 's|^.*\\(stringpool_str[0-9]*\\).*$|  (int)(intptr_t)\\&((struct stringpool_t *)0)->\\1,|'\n");
   for (; n > 0; names++, n--)
     emit_alias(out1, *names, c_name);
 }
diff --git a/lib/genaliases2.c b/lib/genaliases2.c
index 4b7942e..8c67fc1 100644
--- a/lib/genaliases2.c
+++ b/lib/genaliases2.c
@@ -43,7 +43,7 @@ static void emit_alias (FILE* out1, const char* tag, const char* alias, const ch
 
 static void emit_encoding (FILE* out1, FILE* out2, const char* tag, const char* const* names, size_t n, const char* c_name)
 {
-  fprintf(out2,"  (int)(long)&((struct stringpool2_t *)0)->stringpool_%s_%u,\n",tag,counter);
+  fprintf(out2,"  (int)(intptr_t)&((struct stringpool2_t *)0)->stringpool_%s_%u,\n",tag,counter);
   for (; n > 0; names++, n--)
     emit_alias(out1, tag, *names, c_name);
 }
diff --git a/lib/iconv.c b/lib/iconv.c
