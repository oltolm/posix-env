# Site defaults for configure scripts run in the native POSIX environment;
# the posix-env activation script points CONFIG_SITE here.  Paths are
# derived from this file's location, <prefix>/share/posix-env.
posix_env_bin=${CONFIG_SITE%/share/posix-env/*}/bin
posix_env_lib=${CONFIG_SITE%/share/posix-env/*}/lib/posix-env

# config.guess recognizes MinGW only by MSYS's uname -s (MINGW64_NT-...);
# the native uname reports Windows_NT.
test -n "$build_alias" || build_alias=$(uname -m)-w64-mingw32

# Autoconf's program search tries "gcc", never "gcc.exe".
: ${ac_executable_extensions=.exe}

# AC_PROG_SED and AC_PROG_GREP search all of PATH for the "best" program and
# can pick a text-mode one from the toolchain directory, which writes CRLF.
: ${SED=$posix_env_bin/sed.exe}
: ${GREP=$posix_env_bin/grep.exe}
: ${EGREP="$posix_env_bin/grep.exe -E"}
: ${FGREP="$posix_env_bin/grep.exe -F"}

# Searches for a POSIX shell that look only in /bin-style directories of a
# colon-separated PATH (gzip's AC_PROG_SHELL-like check) find none and fall
# back to /bin/sh, which does not exist.  Installed scripts whose #! line
# names this shell need it rewritten to #!/bin/sh (scriptexe finds sh).
: ${ac_cv_path_shell=$CONFIG_SHELL}

# Without a file command, libtool 2.2.x falls back to an i386-only pattern and
# builds no DLL that depends on an x86-64 import library.  Both are computed
# in one cached check, so both must be set.
: ${lt_cv_deplibs_check_method='file_magic file format (pei*-i386(.*architecture: i386)?|pe-arm-wince|pei?-x86-64)'}
: ${lt_cv_file_magic_cmd='$OBJDUMP -f'}

# Each addition below is made once: nested configures (binutils, gcc,
# gettext) inherit LDFLAGS and CPPFLAGS from their parent and read this file
# again, and an object linked twice fails ("multiple definition", ".rsrc
# merge failure").

# Every program gets a manifest that makes UTF-8 its active code page.  It
# replaces mingw-w64's default manifest; -Wl, keeps libtool from treating the
# object as one of the package's own.  A package whose programs embed their
# own manifest sets posix_env_manifest=no and adds activeCodePage to it.
case " $LDFLAGS " in
*/utf8-manifest.o*) ;;
*)
  if test "${posix_env_manifest-yes}" != no; then
    LDFLAGS="$LDFLAGS -Wl,$posix_env_lib/utf8-manifest.o"
  fi
  ;;
esac

# The UCRT's setlocale (CATEGORY, "") follows the Windows settings (decimal
# comma, local month names), not LC_ALL, LC_<CATEGORY> and LANG, and it
# rejects "POSIX" and "C.UTF-8".  Calls to it and to _wsetlocale go through
# c-locale.o, which follows the variables, falls back to "C" and maps those
# two names.  An object in LDFLAGS, not a library in LIBS: some packages
# link without LIBS (libiconv's libcharset).  The C runtime's import library
# follows it: libtool links C++ libraries with -nostdlib and puts the runtime
# libraries before these flags.  DLLs must not export its pointers, or
# programs linked against them would bind to those.
case " $LDFLAGS " in
*/c-locale.o*) ;;
*) LDFLAGS="$LDFLAGS -Wl,--wrap=__imp_setlocale -Wl,--wrap=__imp__wsetlocale -Wl,$posix_env_lib/c-locale.o,-lmsvcrt -Wl,--exclude-symbols=__wrap___imp_setlocale -Wl,--exclude-symbols=__wrap___imp__wsetlocale" ;;
esac

# <libintl.h> redirects setlocale to libintl_setlocale on Windows, which in
# a UTF-8 process takes "C" as "English_United States.65001": LC_ALL=C
# would give multibyte characters.  Keep the C runtime's setlocale, which
# c-locale.o handles; libintl finds the message locale in LC_ALL,
# LC_MESSAGES and LANG itself.
case " $CPPFLAGS " in
*" -D_INTL_NO_DEFINE_MACRO_SETLOCALE "*) ;;
*) CPPFLAGS="$CPPFLAGS -D_INTL_NO_DEFINE_MACRO_SETLOCALE" ;;
esac

# Programs read and write bytes, as on POSIX systems: binmode.o puts
# stdin, stdout, stderr and the files a program opens in binary mode (the
# UCRT's text mode writes CRLF and drops CR).  It acts only in programs, not
# in DLLs.  Its libraries follow it for the same reason as c-locale.o's.
case " $LDFLAGS " in
*/binmode.o*) ;;
*) LDFLAGS="$LDFLAGS -Wl,$posix_env_lib/binmode.o,-lmsvcrt,-lkernel32" ;;
esac

unset posix_env_bin posix_env_lib
