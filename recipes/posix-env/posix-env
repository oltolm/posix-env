#!/bin/sh
# posix-env COMMAND [ARGUMENTS]: the launcher's commands in the shell
# (install, remove, list, update, run, help), as "posix-shell COMMAND" runs
# them from cmd.  posix-shell.cmd names itself in POSIX_ENV_LAUNCHER when
# it starts the shell.
if test -z "$POSIX_ENV_LAUNCHER"; then
  echo "posix-env: this shell was not started by posix-shell.cmd" >&2
  echo "  (POSIX_ENV_LAUNCHER is not set); run posix-shell.cmd from cmd" >&2
  exit 1
fi
if test $# -eq 0; then
  set -- help
fi
exec "$POSIX_ENV_LAUNCHER" "$@"
