From: Oleg Tolmatcev
Subject: [PATCH] Makefile.wng: PCRE2 as a regex package

MinGW builds could choose POSIX, GNU or Henry Spencer's regex, not the
PCRE2 that configure builds use. REGEX_PACKAGE=pcre2 defines HAVE_PCRE2.
---
--- a/Makefile.wng
+++ b/Makefile.wng
@@ -22,6 +22,10 @@
 # REGEX_PACKAGE == posix  (might not be available)
 #   This choice selects the POSIX implementation, if provided by MingW.
 #
+# REGEX_PACKAGE == pcre2  (might not be available)
+#   This choice selects PCRE2; set MINGW_REGEX_IPATH, MINGW_REGEX_LPATH
+#   and MINGW_REGEX_LIB=-lpcre2-8 to find it.
+#
 # REGEX_PACKAGE == gnu  (might not be available)
 #   This choice selects the GNU implementation, if provided by MingW.
 #
@@ -55,12 +59,14 @@
     MINGW_DEFINES += -DUSE_REGEXP_C
 else ifeq (${REGEX_PACKAGE},posix)
     MINGW_DEFINES += -DUSE_POSIX_REGCOMP
+else ifeq (${REGEX_PACKAGE},pcre2)
+    MINGW_DEFINES += -DUSE_PCRE2
 else ifeq (${REGEX_PACKAGE},gnu)
     MINGW_DEFINES += -DUSE_GNU_REGEX
 else ifeq (${REGEX_PACKAGE},none)
 #    without specific regex package, defines.wn sets NO_REGEX=1
 else
-    $(error REGEX_PACKAGE must be posix, gnu, regcomp-local or none)
+    $(error REGEX_PACKAGE must be posix, pcre2, gnu, regcomp-local or none)
 endif
 
 MINGW_REGEX_IPATH = -I${MINGW_ROOT_PATH}/opt/include
--- a/defines.wn
+++ b/defines.wn
@@ -236,6 +236,9 @@
 /* #undef HAVE_RE_COMP */
 /* #undef HAVE_REGCMP */
 #ifdef MINGW
+    #ifdef USE_PCRE2
+        #define HAVE_PCRE2 1
+    #else
     #ifdef USE_POSIX_REGCOMP
         #define HAVE_POSIX_REGCOMP 1
     #else
@@ -250,6 +253,7 @@
             #endif
         #endif
     #endif
+    #endif
 #else
 #define HAVE_V8_REGCOMP 1
 /* #undef NO_REGEX */
