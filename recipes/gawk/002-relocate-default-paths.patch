 #define WIN32_LEAN_AND_MEAN
 #include <windows.h>
 
+/* w32_relocate_default_paths --- base the default AWKPATH and AWKLIBPATH on
+   where gawk.exe is installed.  DEFPATH and DEFLIBPATH name the prefix gawk
+   was built for, which a relocated installation does not have.  gawk.exe is
+   in PREFIX/bin, the awk library in PREFIX/lib/awk and extensions in
+   PREFIX/lib/gawk; without that layout the compiled-in values stay.  */
+
+void
+w32_relocate_default_paths (void)
+{
+	static const char tail[] = ";c:/lib/awk;c:/gnu/lib/awk";
+	char exe[MAX_PATH];
+	char *p, *path, *libpath;
+	DWORD n = GetModuleFileNameA (NULL, exe, sizeof exe);
+
+	if (n == 0 || n >= sizeof exe)
+		return;
+	for (p = exe; *p; p++)
+		if (*p == '\\')
+			*p = '/';
+	/* Strip "/gawk.exe", then "/bin".  */
+	if ((p = strrchr (exe, '/')) == NULL)
+		return;
+	*p = '\0';
+	if ((p = strrchr (exe, '/')) == NULL || stricmp (p, "/bin") != 0)
+		return;
+	*p = '\0';
+
+	path = malloc (strlen (".;") + strlen (exe) + strlen ("/lib/awk")
+		       + strlen (tail) + 1);
+	libpath = malloc (strlen (exe) + strlen ("/lib/gawk") + 1);
+	if (path == NULL || libpath == NULL) {
+		free (path);
+		free (libpath);
+		return;
+	}
+	sprintf (path, ".;%s/lib/awk%s", exe, tail);
+	sprintf (libpath, "%s/lib/gawk", exe);
+	defpath = path;
+	deflibpath = libpath;
+}
+
 /* gawk_name --- pull out the "gawk" part from how the OS called us */
 
