diff --git a/missing_d/strftime.c b/missing_d/strftime.c
index c795a08..e0c0ead 100644
--- a/missing_d/strftime.c
+++ b/missing_d/strftime.c
@@ -905,7 +905,8 @@ my_strftime (s, maxsize, format, tp ut_argument LOCALE_PARAM)
 	       "#define strftime rpl_strftime".  */
 # ifdef strftime
 #  undef strftime
-	    size_t strftime ();
+	    /* A real prototype: in C23, () means no parameters.  */
+	    size_t strftime (char *, size_t, const char *, const struct tm *);
 # endif
 
 	    *u++ = '%';
diff --git a/pc/config.h b/pc/config.h
index 70bcce0..177e31d 100644
--- a/pc/config.h
+++ b/pc/config.h
@@ -208,7 +208,12 @@
 #undef HAVE_STRCASECMP
 
 /* Define to 1 if you have the `strcoll' function. */
+/* UCRT has strcoll, and its import library clashes with the replacement.  */
+#ifdef _UCRT
+#define HAVE_STRCOLL 1
+#else
 #undef HAVE_STRCOLL
+#endif
 
 /* Define to 1 if you have the `strftime' function. */
 /* MinGW uses the replacement from missing_d, to support the %e specifier.  */
diff --git a/pc/mbc32.h b/pc/mbc32.h
index 36f46f0..54c8d23 100644
--- a/pc/mbc32.h
+++ b/pc/mbc32.h
@@ -34,6 +34,10 @@
 #ifndef MBC32_H
 #define MBC32_H
 
+/* _UCRT is defined by _mingw.h; config.h includes this header before any
+   system header, which would otherwise select the MSVCRT emulation.  */
+#include <_mingw.h>
+
 /* MinGW64 build linked against UCRT has somne of this in its library,
    via uchar.h.  */
 #ifdef _UCRT
diff --git a/pc/nl_langinfo.c b/pc/nl_langinfo.c
index a7ef84d..ca33282 100644
--- a/pc/nl_langinfo.c
+++ b/pc/nl_langinfo.c
@@ -146,8 +146,8 @@ mingw_mb_cur_max (void)
 {
   if (mingw_using_utf8 (UTF8_QUERY))
     return 4;
-  /* __mb_cur_max is either a macro defined to call an internal CRT
-     function, or an internal variable of CRT that is updated when
-     setlocale is called.  */
-  return __mb_cur_max;
+  /* custom.h defines MB_CUR_MAX as a call to this function, so mingw-w64's
+     stdlib.h neither defines nor declares the CRT function behind it.  */
+  extern int __cdecl ___mb_cur_max_func (void);
+  return ___mb_cur_max_func ();
 }
diff --git a/pc/popen.c b/pc/popen.c
index 300464b..f65bf9d 100644
--- a/pc/popen.c
+++ b/pc/popen.c
@@ -232,7 +232,8 @@ os_popen(const char *command, const char *mode )
     strncpy(curmode, mode, 3); curmode[3] = '\0';
 
 #if defined(__MINGW32__)
-    current = popen(command, mode);
+    /* popen.h undefines mingw-w64's popen macro.  */
+    current = _popen(command, mode);
     cur = fileno(current);
     strcpy(pipes[cur].pmode, curmode);
     return(current);
@@ -278,7 +279,7 @@ os_pclose( FILE * current)
     int fd, rval;
 
 #if defined(__MINGW32__)
-    rval = pclose(current);
+    rval = _pclose(current);
     *pipes[cur].pmode = '\0';
     return rval;
 #endif
