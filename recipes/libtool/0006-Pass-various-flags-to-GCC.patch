0006-Pass-various-flags-to-GCC.patch
From MSYS2's mingw-w64-libtool.

diff --git a/build-aux/ltmain.in b/build-aux/ltmain.in
index ab175a2..ead91ef 100644
--- a/build-aux/ltmain.in
+++ b/build-aux/ltmain.in
@@ -5712,6 +5712,7 @@ func_mode_link ()
       # -static-libsan       Link with static sanitizer runtimes (Clang)
       # -no-canonical-prefixes Do not expand any symbolic links
       # -fuse-ld=*           Linker select flags for GCC
+      # -shared-*            direct GCC to link specific libraries dynamically
       # -static-*            direct GCC to link specific libraries statically
       # -fcilkplus           Cilk Plus language extension features for C/C++
       # -resource-dir=*      for selecting compiler resource directory with clang
@@ -5727,6 +5728,7 @@ func_mode_link ()
       -specs=*|-fsanitize=*|-fno-sanitize*|-shared-libsan|-static-libsan| \
       -ffile-prefix-map=*|-fdebug-prefix-map=*|-fmacro-prefix-map=*|-fprofile-prefix-map=*| \
       -fdiagnostics-color*|-frecord-gcc-switches| \
+      -ffast-math|-fgnu-tm|-ftree-parallelize-loops=*|-funsafe-math-optimizations|-fvtable-verify*|-shared-*| \
       -fuse-ld=*|-static-*|-fcilkplus|-W*)
         func_quote_arg pretty "$arg"
 	arg=$func_quote_arg_result
