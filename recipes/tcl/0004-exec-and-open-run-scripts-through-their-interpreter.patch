+/*
+ *----------------------------------------------------------------------
+ *
+ * ScriptInterpreter --
+ *
+ *	posix-env: finds the interpreter named on a script's #! line, as
+ *	POSIX systems run it: the interpreter, at most one argument (the
+ *	rest of the line), the script, the script's arguments.  The
+ *	interpreter is looked up by its path first, then by its file name
+ *	in PATH (#!/bin/sh finds sh.exe); "#!/usr/bin/env NAME" looks up
+ *	NAME.
+ *
+ * Results:
+ *	The interpreter's application type as for ApplicationType, with its
+ *	path in fullName and its argument in scriptPtr->arg; APPL_NONE with
+ *	an error message in interp if there is none.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static int
+ScriptInterpreter(
+    Tcl_Interp *interp,		/* Interp, for error message. */
+    ScriptInfo *scriptPtr,	/* The script; its arg is filled in. */
+    char fullName[])		/* Filled with the interpreter's path. */
+{
+    char name[MAX_PATH * TCL_UTF_MAX];
+    char *line = scriptPtr->line, *p, *base;
+    size_t len;
+    int applType;
+
+    while (*line == ' ' || *line == '\t') {
+	line++;
+    }
+    len = strcspn(line, " \t");
+    memcpy(name, line, len);
+    name[len] = '\0';
+    line += len;
+    while (*line == ' ' || *line == '\t') {
+	line++;
+    }
+    len = strlen(line);
+    while (len > 0 && (line[len - 1] == ' ' || line[len - 1] == '\t')) {
+	len--;
+    }
+    line[len] = '\0';
+
+    base = name;
+    for (p = name; *p != '\0'; p++) {
+	if (*p == '/' || *p == '\\') {
+	    base = p + 1;
+	}
+    }
+    if ((strcmp(base, "env") == 0 || strcasecmp(base, "env.exe") == 0)
+	    && *line != '\0') {
+	len = strcspn(line, " \t");
+	memmove(name, line, len);
+	name[len] = '\0';
+	line += len;
+	while (*line == ' ' || *line == '\t') {
+	    line++;
+	}
+	base = name;
+    }
+    strcpy(scriptPtr->arg, line);
+
+    if (name[0] == '\0') {
+	Tcl_SetObjResult(interp, Tcl_ObjPrintf(
+		"couldn't execute \"%s\": no interpreter on its #! line",
+		scriptPtr->path));
+	return APPL_NONE;
+    }
+    applType = ApplicationType(interp, name, fullName, NULL);
+    if (applType == APPL_NONE && base != name) {
+	Tcl_ResetResult(interp);
+	applType = ApplicationType(interp, base, fullName, NULL);
+    }
+    if (applType == APPL_NONE) {
+	Tcl_SetObjResult(interp, Tcl_ObjPrintf(
+		"couldn't execute \"%s\": interpreter \"%s\" not found",
+		scriptPtr->path, name));
+    }
+    return applType;
+}
 
