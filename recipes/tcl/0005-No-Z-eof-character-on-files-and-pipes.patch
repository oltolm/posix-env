From e0dcede7ed0b63ed3fe7e8aa8a15cd731e1897da Mon Sep 17 00:00:00 2001
From: Oleg Tolmatcev <oleg.tolmatcev@gmail.com>
Date: Tue, 6 Oct 2026 19:30:18 +0200
Subject: [PATCH 5/8] No ^Z eof character on files and pipes

---
 win/tclWinChan.c | 11 ++++++-----
 win/tclWinPipe.c |  7 +++----
 2 files changed, 9 insertions(+), 9 deletions(-)

diff --git a/win/tclWinChan.c b/win/tclWinChan.c
index 98cba33..4be4ab5 100644
--- a/win/tclWinChan.c
+++ b/win/tclWinChan.c
@@ -1336,11 +1336,12 @@ TclpGetDefaultStdChannel(
     }
 
     /*
-     * Set up the normal channel options for stdio handles.
+     * Set up the normal channel options for stdio handles (posix-env: no
+     * ^Z eof char).
      */
 
     if (Tcl_SetChannelOption(NULL,channel,"-translation","auto")!=TCL_OK ||
-	    Tcl_SetChannelOption(NULL,channel,"-eofchar","\032 {}")!=TCL_OK ||
+	    Tcl_SetChannelOption(NULL,channel,"-eofchar","")!=TCL_OK ||
 	    Tcl_SetChannelOption(NULL,channel,"-buffering",bufMode)!=TCL_OK) {
 	Tcl_Close(NULL, channel);
 	return (Tcl_Channel) NULL;
@@ -1412,12 +1413,12 @@ OpenFileChannel(
 	    infoPtr, permissions);
 
     /*
-     * Files have default translation of AUTO and ^Z eof char, which means
-     * that a ^Z will be accepted as EOF when reading.
+     * Files have default translation of AUTO.  posix-env: no ^Z eof char,
+     * as on POSIX systems; a ^Z in a file is data.
      */
 
     Tcl_SetChannelOption(NULL, infoPtr->channel, "-translation", "auto");
-    Tcl_SetChannelOption(NULL, infoPtr->channel, "-eofchar", "\032 {}");
+    Tcl_SetChannelOption(NULL, infoPtr->channel, "-eofchar", "");
 
     return infoPtr->channel;
 }
diff --git a/win/tclWinPipe.c b/win/tclWinPipe.c
index 841e642..abe83dd 100644
--- a/win/tclWinPipe.c
+++ b/win/tclWinPipe.c
@@ -2053,13 +2053,12 @@ TclpCreateCommandChannel(
 	    infoPtr, infoPtr->validMask);
 
     /*
-     * Pipes have AUTO translation mode on Windows and ^Z eof char, which
-     * means that a ^Z will be appended to them at close. This is needed for
-     * Windows programs that expect a ^Z at EOF.
+     * Pipes have AUTO translation mode on Windows.  posix-env: no ^Z eof
+     * char, as on POSIX systems; a ^Z in a program's output is data.
      */
 
     Tcl_SetChannelOption(NULL, infoPtr->channel, "-translation", "auto");
-    Tcl_SetChannelOption(NULL, infoPtr->channel, "-eofchar", "\032 {}");
+    Tcl_SetChannelOption(NULL, infoPtr->channel, "-eofchar", "");
     return infoPtr->channel;
 }
 
