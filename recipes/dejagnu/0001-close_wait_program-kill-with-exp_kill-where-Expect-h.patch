From ab92e49d5997c11166f2d14e498d6b30d45110b6 Mon Sep 17 00:00:00 2001
From: Oleg Tolmatcev <oleg.tolmatcev@gmail.com>
Date: Tue, 6 Oct 2026 19:58:54 +0200
Subject: [PATCH 1/4] close_wait_program: kill with exp_kill where Expect has
 it (native Windows)

---
 lib/remote.exp | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/lib/remote.exp b/lib/remote.exp
index 1c9971a..4089e19 100644
--- a/lib/remote.exp
+++ b/lib/remote.exp
@@ -66,7 +66,14 @@ proc close_wait_program { program_id pid {wres_varname ""} } {
 
     set exec_pid -1
 
-    if { $pid > 0 } {
+    if { $pid > 0 && [llength [info commands exp_kill]] } {
+	# Native Windows (posix-env's Expect): no signals and no process
+	# groups; exp_kill ends each process and its children.
+	verbose "doing kill, pid is $pid"
+	foreach spid $pid {
+	    exp_kill $spid
+	}
+    } elseif { $pid > 0 } {
 	# Tcl has no kill primitive, so we have to execute an external
 	# command in order to kill the process.
 	verbose "doing kill, pid is $pid"
-- 
2.56.0.windows.1

