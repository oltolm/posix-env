Take the DLL name suffix from the target's multilib setting.  From MSYS2's
mingw-w64-openssl (004-arch-suffix.patch).

diff --git a/Configurations/10-main.conf b/Configurations/10-main.conf
index 0344ac0..c559945 100644
--- a/Configurations/10-main.conf
+++ b/Configurations/10-main.conf
@@ -1745,7 +1745,7 @@ my %targets = (
         uplink_arch      => undef,
         perlasm_scheme   => "mingw64",
         shared_rcflag    => "--target=pe-x86-64",
-        multilib         => "64",
+        multilib         => "-x64",
     },
 
     "mingwarm64" => {
diff --git a/Configurations/platform/mingw.pm b/Configurations/platform/mingw.pm
index c4dbce8..fbf571e 100644
--- a/Configurations/platform/mingw.pm
+++ b/Configurations/platform/mingw.pm
@@ -33,8 +33,7 @@ sub sharedname {
     return platform::BASE::__concat(platform::BASE->sharedname($_[1]),
                                     "-",
                                     $_[0]->shlib_version_as_filename(),
-                                    ($config{target} eq "mingw64"
-                                         ? "-x64" : ""));
+                                    ($target{multilib} // '' ));
 }
 
 # With Mingw and other DLL producers, there isn't any "simpler" shared
