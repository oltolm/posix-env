Build on native Windows (MinGW-w64, UCRT): no getrlimit (a fixed limit
for the directory descriptor cache), no S_IFLNK in st_mode (any nonzero
file type that no regular file has), no owners or groups (getegid,
fchown are no-ops; fchmod too, as files are written through the
descriptor and only a read-only bit exists), no SIGHUP or SIGCHLD.

diff --git a/src/common.h b/src/common.h
--- a/src/common.h
+++ b/src/common.h
@@ -43,6 +43,20 @@
 #include <time.h>
 #include <unistd.h>
 
+#ifdef _WIN32
+/* Native Windows has no symbolic link file type in st_mode, and no
+   owners or groups to set.  patch only needs S_IFLNK to be a nonzero
+   file type that no regular file has.  */
+# ifndef S_IFLNK
+#  define S_IFLNK 0120000
+# endif
+# define getegid() ((gid_t) 0)
+# define fchown(fd, uid, gid) ((void) (fd), (void) (uid), (void) (gid), 0)
+/* Only the read-only bit exists, and the file is written through FD
+   anyway.  */
+# define fchmod(fd, mode) ((void) (fd), (void) (mode), 0)
+#endif
+
 /* handy definitions */
 
 #define strEQ(s1,s2) (!strcmp(s1, s2))
diff --git a/src/safe.c b/src/safe.c
--- a/src/safe.c
