@@ -21,7 +21,13 @@
 #include <config.h>
 #include <sys/types.h>
 #include <sys/stat.h>
-#include <sys/resource.h>
+#ifndef _WIN32
+# include <sys/resource.h>
+#else
+/* No getrlimit; see init_dirfd_cache.  */
+typedef unsigned long rlim_t;
+# define RLIM_INFINITY ((rlim_t) -1)
+#endif
 #include <sys/time.h>
 #include <fcntl.h>
 #include <stdio.h>
@@ -103,6 +109,10 @@
 
 static void init_dirfd_cache (void)
 {
+#ifdef _WIN32
+  /* No getrlimit; the UCRT allows 8192 descriptors.  */
+  max_cached_fds = MAX (8192 / 4, min_cached_fds);
+#else
   struct rlimit nofile;
 
   if (getrlimit (RLIMIT_NOFILE, &nofile) == 0)
@@ -114,6 +124,7 @@
     }
   else
     max_cached_fds = min_cached_fds;
+#endif
 
   cached_dirfds = hash_initialize (min_cached_fds, nullptr,
 				   hash_cached_dirfd,
