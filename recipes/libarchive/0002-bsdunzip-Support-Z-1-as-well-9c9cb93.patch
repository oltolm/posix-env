From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Tobias Stoeckmann <tobias@stoeckmann.org>
Date: Sun, 4 Oct 2026 17:15:46 +0200
Subject: [PATCH 2/6] bsdunzip: Support -Z -1 as well (9c9cb93)

---
 unzip/bsdunzip.c     |  3 ++-
 unzip/test/test_Z1.c | 14 ++++++++++++++
 2 files changed, 16 insertions(+), 1 deletion(-)

diff --git a/unzip/bsdunzip.c b/unzip/bsdunzip.c
index ccca15e..b7cf7cb 100644
--- a/unzip/bsdunzip.c
+++ b/unzip/bsdunzip.c
@@ -1204,7 +1204,8 @@ getopts(int argc, char *argv[])
 		case 'Z':
 			zipinfo_mode = 1;
 			if (bsdunzip->argument != NULL &&
-			    strcmp(bsdunzip->argument, "1") == 0) {
+			    (strcmp(bsdunzip->argument, "1") == 0 ||
+			    strcmp(bsdunzip->argument, "-1") == 0)) {
 				Z1_opt = 1;
 			}
 			break;
diff --git a/unzip/test/test_Z1.c b/unzip/test/test_Z1.c
index 2a3012b..ca70805 100644
--- a/unzip/test/test_Z1.c
+++ b/unzip/test/test_Z1.c
@@ -19,3 +19,17 @@ DEFINE_TEST(test_Z1)
 	assertTextFileContents("test_basic/\ntest_basic/a\ntest_basic/b\ntest_basic/c\ntest_basic/CAPS\n", "test.out");
 	assertEmptyFile("test.err");
 }
+
+/* Test -Z -1 arg - List filenames */
+DEFINE_TEST(test_Z_1)
+{
+	const char *reffile = "test_basic.zip";
+	int r;
+
+	extract_reference_file(reffile);
+	r = systemf("%s -Z -1 %s >test.out 2>test.err", testprog, reffile);
+	assertEqualInt(0, r);
+	assertNonEmptyFile("test.out");
+	assertTextFileContents("test_basic/\ntest_basic/a\ntest_basic/b\ntest_basic/c\ntest_basic/CAPS\n", "test.out");
+	assertEmptyFile("test.err");
+}
